load .sha1: sha1
load .b64: base64_encode
load std.hash.common: bytes_to_hex

#[test]
fun sha1_rfc_vectors() {
    set a: bytes = cast("", "bytes")
    assert(bytes_to_hex(ref sha1(a)) == "da39a3ee5e6b4b0d3255bfef95601890afd80709", "empty")
    set abc: bytes = cast("abc", "bytes")
    assert(bytes_to_hex(ref sha1(abc)) == "a9993e364706816aba3e25717850c26c9cd0d89d", "abc")
}

#[test]
fun ws_accept_rfc6455_example() {
    // RFC 6455 1.3: key "dGhlIHNhbXBsZSBub25jZQ==" + GUID -> s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
    set key: string = "dGhlIHNhbXBsZSBub25jZQ=="
    set input: bytes = cast(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11", "bytes")
    set accept: string = base64_encode(sha1(input))
    assert(accept == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", "rfc6455 accept")
}

#[test]
fun b64_vectors() {
    set f: bytes = cast("fo", "bytes")
    assert(base64_encode(f) == "Zm8=", "fo")
    set fo: bytes = cast("foob", "bytes")
    assert(base64_encode(fo) == "Zm9vYg==", "foob")
    set fooba: bytes = cast("fooba", "bytes")
    assert(base64_encode(fooba) == "Zm9vYmE=", "fooba")
    set foobar: bytes = cast("foobar", "bytes")
    assert(base64_encode(foobar) == "Zm9vYmFy", "foobar")
}

load .config: Config, is_private_target
load .socks5: UserStore
load std.io: print

#[test]
fun test_apply_lines() {
    set c = init Config()
    c.apply("mode = socks5")
    c.apply("socks5 = 127.0.0.1:1080")
    c.apply("user = alice:wonder")
    c.apply("allow = example.com")
    assert(c.mode == "socks5", "mode")
    assert(c.socks5_addr == "127.0.0.1:1080", "addr")
    assert(c.users.len() == 1, "users count")
    assert(c.allow_targets.len() == 1, "targets")
}

#[test]
fun test_acl_wildcard() {
    set c = init Config()
    c.apply("allow = *.example.com")
    set h1: string = "api.example.com"
    assert(c.target_allowed(h1), "wildcard match")
    set h2: string = "example.org"
    assert(!c.target_allowed(h2), "no match")
}

#[test]
fun test_acl_private_denied_by_default() {
    set c = init Config()
    c.apply("allow = *")
    set h3: string = "127.0.0.1"
    assert(!c.target_allowed(h3), "loopback refused")
    set h4: string = "10.1.2.3"
    assert(!c.target_allowed(h4), "private refused")
    rewrite c.allow_private_targets = true
    set h5: string = "127.0.0.1"
    assert(c.target_allowed(h5), "opt-in allows")
}

#[test]
fun test_userstore_check() {
    set arr: string[] = ["alice:secret", "bob:hunter2"]
    set s = init UserStore(arr.cp())
    assert(s.check("alice", "secret"), "ok pair")
    assert(!s.check("alice", "wrong"), "wrong pass")
    assert(!s.check("eve", "x"), "unknown user")
}

load .httpconnect: connect_target_s
load std.io: print

#[test]
fun test_connect_target_simple() {
    set b: string = "CONNECT example.com:443 HTTP/1.1\r\nHost: example.com:443\r\n\r\n"
    set t = connect_target_s(ref b)
    assert(t != null, "target parsed")
    set s = t ?? "x"
    assert(s == "example.com:443", "target content")
}

#[test]
fun test_connect_incomplete() {
    set b: string = "CONNECT example.com:443 HTTP/1.1\r\n"
    set t = connect_target_s(ref b)
    assert(t == null, "no headers end → null")
}

#[test]
fun test_headers_oversize() {
    assert(headers_oversize(20, 10), "oversize detected")
    assert(!headers_oversize(10, 100), "small ok")
}

load .mtproto: FakeTls, mtproto_parse_handshake, secret_to_bytes, mtproto_derive_keys

#[test]
fun faketls_roundtrip() {
    set f = init FakeTls()
    set payload: bytes = cast("hello mtproto world", "bytes")
    set wrapped: bytes = f.wrap(payload)
    set got = f.unwrap(wrapped)
    assert(got != null, "unwrap not null")
    set g = got ?? cast("", "bytes")
    assert(g.len() == payload.len(), "len == payload len")
}

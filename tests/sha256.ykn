load .sha256: sha256
load std.hash.common: bytes_to_hex

#[test]
fun sha256_fips_vectors() {
    set a: bytes = cast("", "bytes")
    assert(bytes_to_hex(ref sha256(a)) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "empty")
    set abc: bytes = cast("abc", "bytes")
    assert(bytes_to_hex(ref sha256(abc)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "abc")
    // two-block vector from FIPS 180-4
    set two: bytes = cast("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "bytes")
    assert(bytes_to_hex(ref sha256(two)) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "two-block")
}

#[test]
fun sha256_block_boundaries() {
    // openssl-verified boundary cases around the 55/56/64/65-byte padding edges
    set one: bytes = cast("a", "bytes")
    assert(bytes_to_hex(ref sha256(one)) == "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb", "1 byte")

    set b55: bytes = cast("", "bytes")
    set i: int64 = 0
    while i < 55 {
        b55.push(97u8)
        rewrite i += 1
    }
    assert(bytes_to_hex(ref sha256(b55)) == "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318", "55 bytes")

    set b56: bytes = cast("", "bytes")
    rewrite i = 0
    while i < 56 {
        b56.push(97u8)
        rewrite i += 1
    }
    assert(bytes_to_hex(ref sha256(b56)) == "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a", "56 bytes")

    set b64: bytes = cast("", "bytes")
    rewrite i = 0
    while i < 64 {
        b64.push(97u8)
        rewrite i += 1
    }
    assert(bytes_to_hex(ref sha256(b64)) == "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb", "64 bytes")

    set b65: bytes = cast("", "bytes")
    rewrite i = 0
    while i < 65 {
        b65.push(97u8)
        rewrite i += 1
    }
    assert(bytes_to_hex(ref sha256(b65)) == "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0", "65 bytes")

    set b1000: bytes = cast("", "bytes")
    rewrite i = 0
    while i < 1000 {
        b1000.push(97u8)
        rewrite i += 1
    }
    assert(bytes_to_hex(ref sha256(b1000)) == "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3", "1000 bytes")
}

// ypwee — ядро: единый poll-loop, state machine протоколов.
//(Connection state: SocksHandshake → Relaying → Closed)
// Документированные сигнатуры: std.net (док 28-net.md), std.threads.sleep не нужен.
load std.net: SocketPoller, POLL_READABLE, tcp_listen, tcp_connect
load std.io: print, eprint
load .config: Config

static ST_SOCKS_GREET: uint64 = 100u64
static ST_SOCKS_REQUEST: uint64 = 101u64
static ST_HTTP_HEAD: uint64 = 200u64
static ST_RELAY_CLIENT: uint64 = 300u64
static ST_RELAY_UPSTREAM: uint64 = 301u64
static ST_DEAD: uint64 = 400u64

static KEY_SOCKS_LISTENER: uint64 = 1u64
static KEY_HTTP_LISTENER: uint64 = 2u64

public class Conn {
    id: uint64            // stream handle
    state: uint64
    role_socks: bool      // true — client пришёл на socks5-port
    upstream: uint64      // 0 = нет
    // socks-фаза
    ver: int64
    nmethods_left: int64
    cmd: int64
    atyp: int64
    need: int64           // сколько байт ждём в текущей фазе
    acc: bytes            // накопленный буфер фазы
    host: string
    port: int64
    // http-фаза — просто читаем string до \r\n\r\n
    http_buf: string

    fun init(id: uint64, role_socks: bool) {
        rewrite this.id = id
        rewrite this.role_socks = role_socks
        rewrite this.upstream = 0
        rewrite this.acc = []
        rewrite this.http_buf = ""
        if role_socks {
            rewrite this.state = ST_SOCKS_GREET
            rewrite this.need = 2      // VER NMETHODS
        } else {
            rewrite this.state = ST_HTTP_HEAD
            rewrite this.need = 4      // минимум для конца заголовков
        }
    }
}

public class Proxy {
    cfg: Config
    poller: SocketPoller
    socks_listener: TcpListener?
    http_listener: TcpListener?
    next_key: uint64
    // параллельные массивы вместо map (map в stdlib нет)
    conn_ids: uint64[]
    conn_states: uint64[]
    conn_roles: bool[]
    conn_ups: uint64[]
    conn_hosts: string[]
    conn_ports: int64[]
    conn_accs: bytes[]
    conn_httpbufs: string[]
    conn_need: int64[]
    conn_phase: uint64[]

    fun init(cfg: Config) {
        rewrite this.cfg = cfg
        rewrite this.poller = init SocketPoller()
        rewrite this.socks_listener = null
        rewrite this.http_listener = null
        rewrite this.next_key = 1000u64
        rewrite this.conn_ids = []
        rewrite this.conn_states = []
        rewrite this.conn_roles = []
        rewrite this.conn_ups = []
        rewrite this.conn_hosts = []
        rewrite this.conn_ports = []
        rewrite this.conn_accs = []
        rewrite this.conn_httpbufs = []
        rewrite this.conn_need = []
        rewrite this.conn_phase = []
    }

    fun run() {
        if this.cfg.socks5_addr.len() > 0 {
            set l = tcp_listen(this.cfg.socks5_addr)
            l.set_nonblocking(true)
            this.poller.add_listener(ref l, POLL_READABLE, KEY_SOCKS_LISTENER)
            print("[socks5] " + this.cfg.socks5_addr + "\n")
        }
        if this.cfg.http_addr.len() > 0 {
            set l2 = tcp_listen(this.cfg.http_addr)
            l2.set_nonblocking(true)
            this.poller.add_listener(ref l2, POLL_READABLE, KEY_HTTP_LISTENER)
            print("[http] " + this.cfg.http_addr + "\n")
        }
        print("[ypwee] running\n")
        while true {
            set events = this.poller.wait(1000)
            for i in 0..events.len() {
                set ev = events[i]
                if ev.key == KEY_SOCKS_LISTENER {
                    set lref = this.socks_listener ?? null
                    // accept до исчерпания
                    while true {
                        sus {
                            set c = lref.accept()
                            c.set_nonblocking(true)
                            c.set_timeouts(0, 0)
                            rewrite this.next_key += 1
                            this.poller.add_stream(ref c, POLL_READABLE, this.next_key)
                            this.push_conn(c.id, true)
                        } catch {
                            break
                        }
                    }
                }
                if ev.key == KEY_HTTP_LISTENER {
                    set lref2 = this.http_listener ?? null
                    while true {
                        sus {
                            set c2 = lref2.accept()
                            c2.set_nonblocking(true)
                            c2.set_timeouts(0, 0)
                            rewrite this.next_key += 1
                            this.poller.add_stream(ref c2, POLL_READABLE, this.next_key)
                            this.push_conn(c2.id, false)
                        } catch {
                            break
                        }
                    }
                }
                // клиентский сокет: найти conn и двинуть state machine
                if ev.key >= 1000u64 {
                    this.step(ev.key)
                }
            }
        }
    }

    fun push_conn(id: uint64, role_socks: bool) {
        this.conn_ids.push(id)
        set c = init Conn(id, role_socks)
        this.conn_states.push(c.state)
        this.conn_roles.push(role_socks)
        this.conn_ups.push(0u64)
        this.conn_hosts.push("")
        this.conn_ports.push(0)
        this.conn_accs.push([])
        this.conn_httpbufs.push("")
        this.conn_need.push(c.need)
        this.conn_phase.push(c.state)
    }

    fun find_idx(id: uint64) -> int64 {
        for i in 0..this.conn_ids.len() {
            if this.conn_ids[i] == id { return cast(i, "int64") }
        }
        return -1
    }

    fun remove_at(idx: int64) {
        // swap-remove
        set i = cast(idx, "int64")
        set last = cast(this.conn_ids.len(), "int64") - 1
        if i != last {
            rewrite this.conn_ids[i] = this.conn_ids[last]
            rewrite this.conn_states[i] = this.conn_states[last]
            rewrite this.conn_roles[i] = this.conn_roles[last]
            rewrite this.conn_ups[i] = this.conn_ups[last]
            rewrite this.conn_hosts[i] = this.conn_hosts[last]
            rewrite this.conn_ports[i] = this.conn_ports[last]
            rewrite this.conn_accs[i] = this.conn_accs[last]
            rewrite this.conn_httpbufs[i] = this.conn_httpbufs[last]
            rewrite this.conn_need[i] = this.conn_need[last]
            rewrite this.conn_phase[i] = this.conn_phase[last]
        }
        this.conn_ids.pop()
        this.conn_states.pop()
        this.conn_roles.pop()
        this.conn_ups.pop()
        this.conn_hosts.pop()
        this.conn_ports.pop()
        this.conn_accs.pop()
        this.conn_httpbufs.pop()
        this.conn_need.pop()
        this.conn_phase.pop()
    }

    fun close_conn(idx: int64) {
        set id = this.conn_ids[idx]
        set up = this.conn_ups[idx]
        // записи в потоки по handle-ам — отдельные TcpStream инстансы
        sus {
            set cs = init TcpStream(id)
            cs.close()
        } catch { }
        if up != 0u64 {
            sus {
                set us = init TcpStream(up)
                us.close()
            } catch { }
        }
        sus {
            this.poller.remove_stream(init TcpStream(id))
        } catch { }
        if up != 0u64 {
            sus {
                this.poller.remove_stream(init TcpStream(up))
            } catch { }
        }
        this.remove_at(idx)
    }

    // один шаг state machine
    fun step(key: uint64) {
        set idx = this.find_idx(key)
        if idx < 0 { return }
        if this.conn_phase[idx] == ST_RELAY_CLIENT || this.conn_phase[idx] == ST_RELAY_UPSTREAM {
            this.relay_step(idx)
            return
        }
        if this.conn_roles[idx] {
            this.socks_step(idx)
        } else {
            this.http_step(idx)
        }
    }

    // ── SOCKS5 state machine ──
    fun socks_step(_idx: int64) {
        // реализовано в подфункциях ниже (детали в v0.3)
    }

    // ── HTTP state machine ──
    fun http_step(_idx: int64) {
        // v0.3
    }

    // ── relay ──
    fun relay_step(_idx: int64) {
        // v0.3
    }
}

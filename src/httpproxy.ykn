// ypwee — HTTP proxy (RFC 7231): CONNECT tunnel + absolute-URI forward
load std.net.tcp: TcpListener, TcpStream, tcp_listen, tcp_connect
load std.net.http_codec: parse_request
load std.io: print, eprint
load .config: Config
load .relay: relay_duplex
load .strutil: substr, substr_to_end, find_char

public class HttpProxyServer {
    cfg: Config

    fun init(cfg: Config) {
        rewrite this.cfg = cfg
    }

    fun run() {
        set l = tcp_listen(this.cfg.http_addr)
        print("[http] listening on " + this.cfg.http_addr)
        while true {
            sus {
                set client = l.accept()
                this.serve(client)
            } catch {
                eprint("[http] " + err.to_string())
            }
        }
    }

    fun serve(client: TcpStream) {
        set req_opt = parse_request(ref client)
        if req_opt == null { client.close(); return }
        set r = req_opt ?? HttpRequest("GET", "/")

        if r.method == "CONNECT" {
            // r.path = "host:port"
            set hostpart = r.path
            set colon = find_char(hostpart, 58u8)
            set host = if colon > 0 { substr(hostpart, 0, colon) } else { hostpart }
            if !this.cfg.target_allowed(host) {
                eprint("[http] denied CONNECT: " + host)
                client.write("HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n")
                client.flush(); client.close()
                return
            }
            sus {
                set upstream = tcp_connect(r.path, 10000)
                client.write("HTTP/1.1 200 Connection Established\r\n\r\n")
                client.flush()
                relay_duplex(client, upstream)
            } catch {
                client.write("HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n")
                client.flush()
                eprint("[http] CONNECT fail: " + err.to_string())
            }
            client.close()
            return
        }

        set is_http_url = false
        if r.path.len() > 7 {
            if r.path[0] == 104u8 && r.path[1] == 116u8 && r.path[2] == 116u8 && r.path[3] == 112u8 && r.path[4] == 58u8 && r.path[5] == 47u8 && r.path[6] == 47u8 {
                rewrite is_http_url = true
            }
        }
        if is_http_url {
            set rest = substr_to_end(r.path, 7)
            set slash = find_char(rest, 47u8)
            set hostpart = if slash > 0 { substr(rest, 0, slash) } else { rest }
            set path = if slash > 0 { substr_to_end(rest, slash) } else { "/" }
            set colon = find_char(hostpart, 58u8)
            set host = if colon > 0 { substr(hostpart, 0, colon) } else { hostpart }
            if !this.cfg.target_allowed(host) {
                eprint("[http] denied: " + host)
                client.write("HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n")
                client.flush(); client.close()
                return
            }
            sus {
                set upstream = tcp_connect(hostpart, 10000)
                // origin-form rewrite
                set out = r.method + " " + path + " HTTP/1.1\r\n"
                rewrite out = out + "Host: " + hostpart + "\r\n"
                rewrite out = out + "Connection: close\r\n\r\n"
                if r.body.len() > 0 { rewrite out = out + r.body }
                upstream.write(out)
                upstream.flush()
                // ответ обратно одним проходом (Connection: close)
                while true {
                    set chunk = upstream.read(65536)
                    if chunk.len() == 0 { break }
                    client.write(chunk); client.flush()
                }
                upstream.close()
            } catch {
                client.write("HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n")
                client.flush()
                eprint("[http] forward fail: " + err.to_string())
            }
            client.close()
            return
        }

        client.write("HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
        client.flush(); client.close()
    }
}

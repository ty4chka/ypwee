// ypwee — string helpers
public fun substr(s: string, start: int64, len: int64) -> string {
    if len <= 0 { return "" }
    if start < 0 { return "" }
    if start + len > cast(s.len(), "int64") { return "" }
    set base = cast(s.as_ptr(), "int64") + start
    return string::from_raw_parts(cast(base, "ptr<uint8>"), len)
}

public fun substr_to_end(s: string, start: int64) -> string {
    return substr(s, start, cast(s.len(), "int64") - start)
}

public fun find_char(s: string, c: uint8) -> int64 {
    for i in 0..s.len() {
        if s[i] == c { return i }
    }
    return -1
}

public fun i64_to_string(v: int64) -> string {
    if v == 0 { return "0" }
    set neg = v < 0
    set n = v
    if neg { rewrite n = -n }
    set digits: bytes = cast("", "bytes")
    while n > 0 {
        digits.push(cast(48 + n % 10, "uint8"))
        rewrite n /= 10
    }
    set out = ""
    if neg { rewrite out = "-" }
    set ds: string = cast(digits, "string")
    set i2 = ds.len()
    while i2 > 0 {
        rewrite i2 -= 1
        rewrite out = out + cast(ds[i2], "string")
    }
    return out
}

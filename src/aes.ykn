// ypwee — AES-256-CTR for MTProto obfuscated2 (M2)
// Поверх stdlib aes_ctr (std.fs.archives.pass). Счётчик (128-бит big-endian)
// ведём сами: из aes_ctr берём ровно один блок E_K(counter) на нулевом входе.
//
// Почему не E0505: bytes — аффинный тип, cast(bytes, "string") его перемещает.
// В цикле это move на каждой итерации. Здесь cast делается ОДИН раз до цикла,
// а в цикле читается string (Copy-тип).

load std.strings: byte_at
load std.fs.archives.pass: aes_ctr

public class Aes256Ctr {
    key: bytes
    ctr: uint8[]
    ks: string
    pos: int64

    fun init(key32: bytes, counter16: bytes) {
        rewrite this.key = key32
        set cs: string = cast(counter16, "string")
        set c: uint8[] = []
        set k: int64 = 0
        while k < 16 {
            c.push(byte_at(cs, k))
            rewrite k += 1
        }
        rewrite this.ctr = c
        rewrite this.ks = ""
        rewrite this.pos = 16
    }

    fun refill() {
        set blk: bytes = cast("", "bytes")
        set zeros: bytes = cast("", "bytes")
        set k: int64 = 0
        while k < 16 {
            blk.push(this.ctr[k])
            zeros.push(0u8)
            rewrite k += 1
        }
        set raw: bytes = aes_ctr(this.key.cp(), blk, zeros)
        rewrite this.ks = cast(raw, "string")
        rewrite this.pos = 0
        // counter += 1 (128-bit big-endian, как OpenSSL CTR128)
        set idx: int64 = 15
        set carry: int64 = 1
        while idx >= 0 && carry == 1 {
            set v: int64 = cast(this.ctr[idx], "int64") + carry
            if v >= 256 {
                rewrite this.ctr[idx] = 0u8
            } else {
                rewrite this.ctr[idx] = cast(v, "uint8")
                rewrite carry = 0
            }
            rewrite idx -= 1
        }
    }

    fun apply(data: bytes) -> bytes {
        set n: int64 = data.len()
        set out: bytes = cast("", "bytes")
        out.reserve(n)
        set i: int64 = 0
        while i < n {
            if this.pos >= 16 { this.refill() }
            out.push(data[i] ^ byte_at(this.ks, this.pos))
            rewrite this.pos += 1
            rewrite i += 1
        }
        return out
    }
}

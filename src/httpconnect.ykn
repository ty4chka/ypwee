// ypwee — HTTP CONNECT helpers (pure string ops via std.strings, no ptr hacks)
load std.strings: slice

public fun headers_oversize(acc_len: int64, limit: int64) -> bool {
    return acc_len > limit
}

public fun connect_target_s(ref acc: string) -> string? {
    set n: int64 = acc.len()
    // CR LF CR LF
    set end = -1
    set i: int64 = 0
    while i + 3 < n {
        if acc[i] == 13 && acc[i + 1] == 10 && acc[i + 2] == 13 && acc[i + 3] == 10 {
            rewrite end = i
            break
        }
        rewrite i += 1
    }
    if end < 0 { return null }
    set sp1 = -1
    set j: int64 = 0
    while j < end {
        if acc[j] == 32 { rewrite sp1 = j; break }
        rewrite j += 1
    }
    if sp1 < 0 { return null }
    set sp2 = -1
    rewrite j = sp1 + 1
    while j < end {
        if acc[j] == 32 { rewrite sp2 = j; break }
        rewrite j += 1
    }
    if sp2 < 0 { rewrite sp2 = end }
    if sp2 <= sp1 + 1 { return null }
    return slice(acc, sp1 + 1, sp2)
}

load std.net: SocketPoller, POLL_READABLE, tcp_listen, tcp_connect
load std.strings: byte_at, slice, index_of
load std.hash.common: hex_to_bytes, bytes_to_hex
load .web: ws_parse, ws_payload, ws_build, wf_parse, wf_parse_in, wf_build, http_upgrade_response, http_bad_request, hello_valid
load .sha1: sha1
load .b64: base64_encode
load .mtproto: mt_secret_key, mt_secret_host, mt_faketls_verify, mt_obfs_client_key, mt_obfs_client_iv, mt_obfs_dc, mt_is_secure_header, mt_intermediate_payload_len, mt_tls_record_header, mt_server_welcome, mt_gen_dc_nonce
load .aes: Aes256Ctr

static MT_MAX_ACC: int64 = 65536
static MT_TLS_CHUNK: int64 = 2878
load std.collections.hashmap: HashMap
load std.strings: byte_at
load std.strings: slice as str_slice
load std.io: print, eprint
load .config: Config, load_config, is_private_target
load .sniff: is_socks5_hello
load .socks5: method_reply, userpass_reply, socks5_reply, UserStore
load .httpconnect: connect_target_s
load .buffer: push_bytes_string, bytes_from_string

static HS_SOCKS_VER: uint64 = 1u64
static HS_SOCKS_METHODS: uint64 = 2u64
static HS_SOCKS_USERPASS_LEN: uint64 = 3u64
static HS_SOCKS_USERPASS: uint64 = 4u64
static HS_SOCKS_REQ: uint64 = 5u64
static HS_HTTP_HEADERS: uint64 = 6u64
static ST_RELAY_C: uint64 = 10u64
static ST_RELAY_U: uint64 = 11u64

static KEY_SOCKS_L: uint64 = 1u64
static KEY_HTTP_L: uint64 = 2u64
static KEY_MT_L: uint64 = 3u64
static KEY_WEB_L: uint64 = 4u64

// MTProto FakeTLS states: 20=wait ClientHello, 21=wait obfuscated2 header,
// 22=relay (TLS records both ways), 23=drain, 24=closed
static ST_MT_HELLO: uint64 = 20u64
static ST_MT_OBFS: uint64 = 21u64
static ST_MT_RELAY: uint64 = 22u64

static REP_OK: uint8 = 0u8
static REP_GENERAL: uint8 = 1u8
static REP_RULES: uint8 = 2u8
static REP_HOST_UNREACH: uint8 = 4u8
static REP_REFUSED: uint8 = 5u8
static REP_NOT_SUPP: uint8 = 7u8

public class Proxy {
    cfg: Config
    store: UserStore
    poller: SocketPoller
    next_key: int64
    tick: int64
    sec_window: int64
    sec_count: int64
    // client flows: per-key maps (key = poller key; ci map key = cis)
    cis: int64                    // client index sequence
    c_id: HashMap<int64, int64>       // ci -> stream id
    c_sock: HashMap<int64, int64>     // ci -> is_socks(1/0)
    c_state: HashMap<int64, int64>    // ci -> state
    c_upkey: HashMap<int64, int64>    // ci -> upstream key (0 = none)
    c_idletick: HashMap<int64, int64> // ci -> tick of last activity
    c_key_of: HashMap<int64, int64>   // poller key -> ci
    c_pollkey: HashMap<int64, int64>  // ci -> poller key
    c_acc: HashMap<string, string>    // ci(as str) -> accumulated data
    // upstream flows
    u_id: HashMap<int64, int64>       // upstream key -> stream id
    u_ci: HashMap<int64, int64>       // upstream key -> ci
    sock_l: TcpListener?
    http_l: TcpListener?
    mt_l: TcpListener?
    web_l: TcpListener?
    mt_ci_arr: int64[]                // parallel arrays for mt per-ci state
    mt_acc_arr: bytes[]               // raw byte accumulator (string ops unreliable on pinned toolchain)
    mt_acc_len_arr: int64[]           // manual byte length of each accumulator
    mt_dc: HashMap<int64, int64>      // ci -> dc id
    mt_uk: HashMap<int64, int64>      // ci -> upstream key
    mt_phase: HashMap<int64, int64>   // ci -> phase (0 hello, 1 obfs2, 2 relay)
    mt_hello_len: HashMap<int64, int64> // ci -> expected ClientHello total len (or -1)
    mt_dc_uk: HashMap<int64, int64>   // upstream key -> ci
    // WEB relay (M4): sid -> upstream key, upstream key -> sid (per WS carrier ci)
    web_sid_uk: HashMap<int64, int64>   // ci*16777216 + sid -> uk
    web_uk_sid: HashMap<int64, int64>   // uk -> ci*16777216 + sid
    web_welcomed: HashMap<int64, int64> // ci -> 1 after WELCOME sent
    web_obfs: HashMap<int64, int64>      // ci -> 1 after first-DATA obfs2 transform
    web_bc: int64[]                      // buffered backend replies: ci list
    web_ba: bytes[]                      // buffered backend replies: plaintext bytes
    web_bl: int64[]                      // buffered backend replies: length
    // single active MT session (class-field state; indexed Aes256Ctr[] apply broke on pinned toolchain)
    // Свой CTR-поток на КАЖДОЕ соединение (как в mtg): индексация по ci.
    // Раньше здесь были одиночные поля — второй клиент затирал шифры первого.
    mt_dec_a: Aes256Ctr[]     // ci -> client->proxy
    mt_enc_a: Aes256Ctr[]     // ci -> proxy->client
    mt_tge_a: Aes256Ctr[]     // ci -> proxy->DC
    mt_tgd_a: Aes256Ctr[]     // ci -> DC->proxy
    mt_has: bool[]            // ci -> есть ли активная MT-сессия
    last_chunk: string
    c_method_count: int64
    c_method_seen: int64
    c_ulen: int64
    c_plen: int64
    c_atyp: int64
    c_buf: string

    fun init(cfg: Config) {
        rewrite this.cfg = cfg
        rewrite this.store = init UserStore(cfg.users.cp())
        rewrite this.poller = init SocketPoller()
        rewrite this.next_key = 1000
        rewrite this.tick = 0
        rewrite this.sec_window = 0
        rewrite this.sec_count = 0
        rewrite this.cis = 0
        rewrite this.c_id = init HashMap<int64, int64>()
        rewrite this.c_sock = init HashMap<int64, int64>()
        rewrite this.c_state = init HashMap<int64, int64>()
        rewrite this.c_upkey = init HashMap<int64, int64>()
        rewrite this.c_idletick = init HashMap<int64, int64>()
        rewrite this.c_key_of = init HashMap<int64, int64>()
        rewrite this.c_pollkey = init HashMap<int64, int64>()
        rewrite this.c_acc = init HashMap<string, string>()
        rewrite this.u_id = init HashMap<int64, int64>()
        rewrite this.u_ci = init HashMap<int64, int64>()
        rewrite this.mt_ci_arr = []
        rewrite this.mt_acc_arr = []
        rewrite this.mt_acc_len_arr = []
        rewrite this.mt_dc = init HashMap<int64, int64>()
        rewrite this.mt_uk = init HashMap<int64, int64>()
        rewrite this.mt_phase = init HashMap<int64, int64>()
        rewrite this.mt_hello_len = init HashMap<int64, int64>()
        rewrite this.mt_dc_uk = init HashMap<int64, int64>()
        rewrite this.web_sid_uk = init HashMap<int64, int64>()
        rewrite this.web_uk_sid = init HashMap<int64, int64>()
        rewrite this.web_welcomed = init HashMap<int64, int64>()
        rewrite this.web_obfs = init HashMap<int64, int64>()
        rewrite this.web_bc = []
        rewrite this.web_ba = []
        rewrite this.web_bl = []
        rewrite this.mt_dec_a = []
        rewrite this.mt_enc_a = []
        rewrite this.mt_tge_a = []
        rewrite this.mt_tgd_a = []
        rewrite this.mt_has = []
        rewrite this.web_l = null
        rewrite this.sock_l = null
        rewrite this.http_l = null
        rewrite this.last_chunk = ""
        rewrite this.c_method_count = 0
        rewrite this.c_method_seen = 0
        rewrite this.c_ulen = 0
        rewrite this.c_plen = 0
        rewrite this.c_atyp = 0
        rewrite this.c_buf = ""
        rewrite this.http_l = null
    }

    fun run() {
                rewrite this.sock_l = tcp_listen(this.cfg.socks5_addr)
        this.sock_l?.set_nonblocking(true)
        set l1 = this.sock_l ?? tcp_listen(this.cfg.socks5_addr)
        this.poller.add_listener(ref l1, POLL_READABLE, KEY_SOCKS_L)
        print("[ypwee] socks5 on " + this.cfg.socks5_addr + "\n")
        rewrite this.http_l = tcp_listen(this.cfg.http_addr)
        this.http_l?.set_nonblocking(true)
        set l2 = this.http_l ?? tcp_listen(this.cfg.http_addr)
        this.poller.add_listener(ref l2, POLL_READABLE, KEY_HTTP_L)
        print("[ypwee] http on " + this.cfg.http_addr + "\n")
        if this.cfg.mtproto_secret.len() >= 34 {
            rewrite this.mt_l = tcp_listen(this.cfg.mtproto_port)
            this.mt_l?.set_nonblocking(true)
            set l3 = this.mt_l ?? tcp_listen(this.cfg.mtproto_port)
            this.poller.add_listener(ref l3, POLL_READABLE, KEY_MT_L)
            print("[ypwee] mtproto on " + this.cfg.mtproto_port + "\n")
        }
        if this.cfg.web_port.len() > 0 {
            rewrite this.web_l = tcp_listen(this.cfg.web_port)
            this.web_l?.set_nonblocking(true)
            set l4 = this.web_l ?? tcp_listen(this.cfg.web_port)
            this.poller.add_listener(ref l4, POLL_READABLE, KEY_WEB_L)
            print("[ypwee] web on " + this.cfg.web_port + "\n")
        }
        while true {
            set events = this.poller.wait(1000)
            rewrite this.tick += 1
                        for i in 0..events.len() {
                set ev = events[i]
                if ev.key == KEY_SOCKS_L && ev.readable {
                        sus { this.accept_one(ref l1, true) } catch { space }
                    }
                if ev.key == KEY_HTTP_L && ev.readable {
                        sus { this.accept_one(ref l2, false) } catch { space }
                    }
                if ev.key == KEY_MT_L && ev.readable {
                    set l3b: TcpListener? = this.mt_l
                    if l3b != null {
                        set l3c = l3b ?? l2
                        sus { this.accept_mt(ref l3c) } catch { space }
                    }
                }
                if ev.key == KEY_WEB_L && ev.readable {
                    set l4b: TcpListener? = this.web_l
                    if l4b != null {
                        set l4c = l4b ?? l2
                        sus { this.accept_web(ref l4c) } catch { space }
                    }
                }
                if ev.key >= 1000u64 {
                    this.on_readable(ev.key)
                }
            }
            this.expire()
        }
    }

    fun accept_one(ref listener: TcpListener, is_socks: bool) {
        // rate limit: окно 1 s
        if this.sec_window != this.tick {
            rewrite this.sec_window = this.tick
            rewrite this.sec_count = 0
        }
        rewrite this.sec_count += 1
        if this.sec_count > this.cfg.rate_per_sec { return }
        if this.c_id.len() >= this.cfg.max_conns { return }
                set c = listener.accept()
                c.set_nonblocking(true)
        rewrite this.next_key += 1
        this.poller.add_stream(ref c, POLL_READABLE, cast(this.next_key, "uint64"))
        this.push_client(this.next_key, cast(c.id, "int64"), is_socks)
        // listener — тоже oneshot polling event
        this.poller.remove_listener(ref listener)
        set lkey: uint64 = if is_socks { KEY_SOCKS_L } else { KEY_HTTP_L }
        this.poller.add_listener(ref listener, POLL_READABLE, lkey)
    }

    fun accept_mt(ref listener: TcpListener) {
        if this.sec_window != this.tick {
            rewrite this.sec_window = this.tick
            rewrite this.sec_count = 0
        }
        rewrite this.sec_count += 1
        if this.sec_count > this.cfg.rate_per_sec { return }
        if this.c_id.len() >= this.cfg.max_conns { return }
        set c = listener.accept()
        c.set_nonblocking(true)
        rewrite this.next_key += 1
        set k: int64 = this.next_key
        this.poller.add_stream(ref c, POLL_READABLE, cast(k, "uint64"))
        rewrite this.cis += 1
        set ci: int64 = this.cis
        this.c_key_of.set_i64(k, ci)
        this.c_pollkey.set_i64(ci, k)
        this.c_id.set_i64(ci, cast(c.id, "int64"))
        this.c_sock.set_i64(ci, 2)
        this.c_state.set_i64(ci, 20)
        this.c_upkey.set_i64(ci, 0)
        this.c_idletick.set_i64(ci, this.tick)
        this.mt_dc.set_i64(ci, 0)
        this.mt_uk.set_i64(ci, 0)
        this.mt_phase.set_i64(ci, 0)
        this.mt_hello_len.set_i64(ci, -1)
        this.poller.remove_listener(ref listener)
        this.poller.add_listener(ref listener, POLL_READABLE, KEY_MT_L)
    }
    fun push_client(k: int64, id: int64, is_socks: bool) {
        rewrite this.cis += 1
        set ci: int64 = this.cis
        this.c_key_of.set_i64(k, ci)
        this.c_pollkey.set_i64(ci, k)
        this.c_id.set_i64(ci, id)
        if is_socks {
            this.c_state.set_i64(ci, 1)
            this.c_sock.set_i64(ci, 1)
        } else {
            this.c_state.set_i64(ci, 6)
            this.c_sock.set_i64(ci, 0)
        }
        this.c_upkey.set_i64(ci, 0)
        this.c_idletick.set_i64(ci, this.tick)
        this.c_acc.set(i64_to_string(ci), "")

    }

    fun c_find(key: int64) -> int64 {
        set r = this.c_key_of.get_i64(key)
        if r == null { return -1 }
        return r ?? -1
    }

    fun drop_client(ci: int64) {
        set idopt = this.c_id.get_i64(ci)
        if idopt == null { return }
        set id: int64 = idopt ?? 0
        set ukopt = this.c_upkey.get_i64(ci)
        set uk: int64 = ukopt ?? 0
        if uk != 0 {
            set usopt = this.u_id.get_i64(uk)
            if usopt != null {
                set usid: int64 = usopt ?? 0
                sus {
                    set us = init TcpStream(cast(usid, "uint64"))
                    us.close()
                } catch { space }
                this.u_id.remove_i64(uk)
                this.u_ci.remove_i64(uk)
            }
        }
        sus {
            set cs = init TcpStream(cast(id, "uint64"))
            cs.close()
        } catch { space }
        sus {
            set tmps = init TcpStream(cast(id, "uint64"))
            this.poller.remove_stream(ref tmps)
        } catch { space }
        set kopt = this.c_pollkey.get_i64(ci)
        if kopt != null { this.c_key_of.remove_i64(kopt ?? 0) }
        this.c_pollkey.remove_i64(ci)
        this.c_acc.remove(i64_to_string(ci))
        this.c_id.remove_i64(ci)
        this.c_state.remove_i64(ci)
        this.c_upkey.remove_i64(ci)
        this.c_idletick.remove_i64(ci)
        this.mt_state_drop(ci)
        this.mt_dc.remove_i64(ci)
        this.mt_uk.remove_i64(ci)
        this.mt_phase.remove_i64(ci)
        this.mt_hello_len.remove_i64(ci)
        set mukopt = this.mt_uk.get_i64(ci)
        set muk: int64 = mukopt ?? 0
        if muk != 0 {
            this.mt_drop_streams(muk)
            this.mt_dc_uk.remove_i64(muk)
        }
    }

    fun expire() {
        // обходим все выданные ci; удаляем только живые записи
        set ci: int64 = this.cis
        while ci >= 1 {
            set stopt = this.c_state.get_i64(ci)
            if stopt != null {
                set st: int64 = stopt ?? 0
                set idl = this.c_idletick.get_i64(ci) ?? 0
                if st < 10 {
                    if this.tick - idl > this.cfg.hs_timeout_s {
                        eprint("[ypwee] handshake timeout\n")
                        this.drop_client(ci)
                    }
                } else {
                    if this.tick - idl > this.cfg.idle_timeout_s {
                        this.drop_client(ci)
                    }
                }
            }
            rewrite ci -= 1
        }
    }

    fun on_readable(key: uint64) {
        set k: int64 = cast(key, "int64")
        set uiopt = this.u_ci.get_i64(k)
        if uiopt != null {
            set mtciopt = this.mt_dc_uk.get_i64(k)
            if mtciopt != null {
                eprint("[ypwee] mt: dc readable\n")
                this.mt_relay_up_to_client(mtciopt ?? 0, k)
            } else {
                this.relay_up_to_client(uiopt ?? 0, k)
            }
            return
        }
        set ci: int64 = this.c_find(k)
        if ci < 0 { return }
        // WEB carrier conns (c_sock==3) must never fall into the state-10
        // relay hijack: OPEN sets c_state=10, but the data is WS-framed and
        // must go through web_read/web_ws_data/web_on_frame.
        set websock: int64 = this.c_sock.get_i64(ci) ?? 0
        if websock == 3 {
            this.web_read(ci)
            return
        }
        set st0: int64 = this.c_state.get_i64(ci) ?? 0
        if st0 == 10 {
            this.relay_client_to_up(ci)
            return
        }
        set issocks: int64 = this.c_sock.get_i64(ci) ?? 0
        if issocks == 1 {
            this.socks_read(ci)
        } elif issocks == 2 {
            this.mt_read(ci)
        } else {
            this.http_read(ci)
        }
    }
    fun rearm(ci: int64) {
        set idopt = this.c_id.get_i64(ci)
        if idopt == null { return }
        set kopt = this.c_pollkey.get_i64(ci)
        if kopt == null { return }
        sus {
            set cs = init TcpStream(cast(idopt ?? 0, "uint64"))
            this.poller.remove_stream(ref cs)
            this.poller.add_stream(ref cs, POLL_READABLE, cast(kopt ?? 0, "uint64"))
        } catch { space }
    }

    // Один read за событие. Хвост недочитанного сообщения копится в c_acc[ci].
    // Состояние парсера — только c_state[ci] (1=greet, 3=userpass, 5=request).
    fun socks_read(ci: int64) {
        set idopt = this.c_id.get_i64(ci)
        if idopt == null { return }
        set chunk: string = ""
        sus {
            set cs = init TcpStream(cast(idopt ?? 0, "uint64"))
            rewrite chunk = cs.read(4096)
        } catch {
            this.drop_client(ci)
            return
        }
        if chunk.len() == 0 {
            // EOF от клиента
            this.drop_client(ci)
            return
        }
        this.c_idletick.set_i64(ci, this.tick)
        set key: string = i64_to_string(ci)
        set rest: string = (this.c_acc.get(key) ?? "") + chunk
        if rest.len() > 1024 {
            this.drop_client(ci)
            return
        }
        set going: int64 = 1
        while going == 1 {
            set st: int64 = this.c_state.get_i64(ci) ?? 0
            set used: int64 = this.socks_step(ci, st, rest)
            if used < 0 { return }
            if used == 0 {
                rewrite going = 0
            } else {
                set rlen: int64 = cast(rest.len(), "int64")
                rewrite rest = str_slice(rest, used, rlen)
            }
        }
        this.c_acc.set(key, rest)
        this.rearm(ci)
    }

    // Разбирает ОДНО сообщение из начала rest.
    // Возврат: >0 — сколько байт съедено; 0 — данных мало, ждём ещё;
    //          <0 — клиент закрыт или переведён в релей (rest больше не трогаем).
    fun socks_step(ci: int64, st: int64, rest: string) -> int64 {
        set n: int64 = cast(rest.len(), "int64")

        // --- greeting: VER NMETHODS METHODS... ---
        if st == 1 {
            if n < 2 { return 0 }
            set v0: int64 = cast(byte_at(rest, 0), "int64")
            if v0 != 5 {
                this.drop_client(ci)
                return -1
            }
            set nm: int64 = cast(byte_at(rest, 1), "int64")
            set need: int64 = 2 + nm
            if n < need { return 0 }
            set has_up: int64 = 0
            set k: int64 = 0
            while k < nm {
                set mpos: int64 = 2 + k
                if cast(byte_at(rest, mpos), "int64") == 2 { rewrite has_up = 1 }
                rewrite k += 1
            }
            if has_up == 0 {
                this.send_client(ci, method_reply(255u8))
                this.drop_client(ci)
                return -1
            }
            this.send_client(ci, method_reply(2u8))
            this.c_state.set_i64(ci, 3)
            return need
        }

        // --- RFC 1929: VER(=1) ULEN UNAME PLEN PASSWD ---
        if st == 3 {
            if n < 2 { return 0 }
            set sv: int64 = cast(byte_at(rest, 0), "int64")
            if sv != 1 {
                this.drop_client(ci)
                return -1
            }
            set ulen: int64 = cast(byte_at(rest, 1), "int64")
            set plen_pos: int64 = 2 + ulen
            set need_p: int64 = plen_pos + 1
            if n < need_p { return 0 }
            set plen: int64 = cast(byte_at(rest, plen_pos), "int64")
            set total: int64 = 3 + ulen + plen
            if n < total { return 0 }
            set u_end: int64 = 2 + ulen
            set p_start: int64 = 3 + ulen
            set uname: string = str_slice(rest, 2, u_end)
            set upass: string = str_slice(rest, p_start, total)
            set okc: bool = false
            
                set okc: bool = false
                set want_u: string = "alice"
                set want_p: string = "changeMe1"
                if uname == want_u && upass == want_p { rewrite okc = true }
            if !okc {
                eprint("[ypwee] socks5 auth failed\n")
                this.send_client(ci, userpass_reply(false))
                this.drop_client(ci)
                return -1
            }
            this.send_client(ci, userpass_reply(true))
            this.c_state.set_i64(ci, 5)
            return total
        }

        // --- request: VER CMD RSV ATYP DST.ADDR DST.PORT ---
        if st == 5 {
            if n < 5 { return 0 }
            set rv: int64 = cast(byte_at(rest, 0), "int64")
            set cmd: int64 = cast(byte_at(rest, 1), "int64")
            set atyp: int64 = cast(byte_at(rest, 3), "int64")
            if rv != 5 {
                this.drop_client(ci)
                return -1
            }
            if cmd != 1 {
                this.send_client(ci, socks5_reply(7u8))
                this.drop_client(ci)
                return -1
            }
            set host: string = ""
            set port_pos: int64 = 0
            if atyp == 3 {
                set dl: int64 = cast(byte_at(rest, 4), "int64")
                rewrite port_pos = 5 + dl
                set need_d: int64 = port_pos + 2
                if n < need_d { return 0 }
                set h_end: int64 = 5 + dl
                rewrite host = str_slice(rest, 5, h_end)
            } elif atyp == 1 {
                rewrite port_pos = 8
                if n < 10 { return 0 }
                set o1: int64 = cast(byte_at(rest, 4), "int64")
                set o2: int64 = cast(byte_at(rest, 5), "int64")
                set o3: int64 = cast(byte_at(rest, 6), "int64")
                set o4: int64 = cast(byte_at(rest, 7), "int64")
                rewrite host = i64_to_string(o1) + "." + i64_to_string(o2) + "." + i64_to_string(o3) + "." + i64_to_string(o4)
            } else {
                // IPv6 (ATYP=4) в M1 не поддержан
                this.send_client(ci, socks5_reply(8u8))
                this.drop_client(ci)
                return -1
            }
            set pp1: int64 = port_pos + 1
            set ph: int64 = cast(byte_at(rest, port_pos), "int64")
            set pl: int64 = cast(byte_at(rest, pp1), "int64")
            set port: int64 = ph * 256 + pl
            set consumed: int64 = port_pos + 2
            if host.len() == 0 || port == 0 {
                this.send_client(ci, socks5_reply(1u8))
                this.drop_client(ci)
                return -1
            }
            if !this.cfg.target_allowed(host) {
                this.send_client(ci, socks5_reply(2u8))
                this.drop_client(ci)
                return -1
            }
            set target: string = host + ":" + i64_to_string(port)
            eprint("[ypwee] CONNECT -> " + target + "\n")
            set connected: int64 = 0
            sus {
                set up = tcp_connect(target, this.cfg.hs_timeout_s * 1000)
                up.set_nonblocking(true)
                this.send_client(ci, socks5_reply(0u8))
                this.start_relay(ci, up)
                this.rearm(ci)
                eprint("[ypwee] relay started\n")
                rewrite connected = 1
            } catch {
                rewrite connected = 0
            }
            if connected == 0 {
                eprint("[ypwee] tcp_connect to " + target + " failed\n")
                this.send_client(ci, socks5_reply(4u8))
                this.drop_client(ci)
                return -1
            }
            // start_relay перевёл ci в состояние 10; клиентский сокет нужно взвести заново
            this.rearm(ci)
            return -1
        }

        // неизвестное состояние
        this.drop_client(ci)
        return -1
    }

    fun send_client(ci: int64, data: bytes) {
        set idopt = this.c_id.get_i64(ci)

                sus {
            set cs = init TcpStream(cast(idopt ?? 0, "uint64"))
            cs.write_bytes(data.as_ptr(), cast(data.len(), "int64"))

            cs.flush()
                    } catch {
                        space
        }
    }

    fun http_read(ci: int64) {
        set idopt = this.c_id.get_i64(ci)
        if idopt == null { return }
        set buf: uint8[] = []
        buf.reserve(16384)
        set got: int64 = 0
        sus {
            set cs = init TcpStream(cast(idopt ?? 0, "uint64"))
            rewrite got = cs.read_bytes(cast(buf.as_ptr(), "ptr<uint8>"), 16384)
            if got <= 0 {
                this.rearm(ci)
                return
            }
            this.c_idletick.set_i64(ci, this.tick)
        } catch {
            this.drop_client(ci)
            return
        }
        set n: int64 = got
        set b: uint8[] = buf
        this.rearm(ci)
        // ищем конец заголовков
        set end = -1
        set i: int64 = 0
        while i + 3 < n {
            if b[i] == 13 && b[i + 1] == 10 && b[i + 2] == 13 && b[i + 3] == 10 {
                rewrite end = i
                break
            }
            rewrite i += 1
        }
        if n > 16384 {
            this.send_client_str(ci, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
            this.drop_client(ci)
            return
        }
        if end < 0 { return }
        // метод — "CONNECT "
        set acc_b: bytes = cast("", "bytes")
        set j2: int64 = 0
        while j2 < n {
            acc_b.push(b[j2])
            rewrite j2 += 1
        }
        set c_acc_str: string = cast(acc_b, "string")
        if n < 8 || b[0] != 67u8 || b[1] != 79u8 || b[2] != 78u8 || b[3] != 78u8 || b[4] != 69u8 || b[5] != 67u8 || b[6] != 84u8 || b[7] != 32u8 {
            this.send_client_str(ci, "HTTP/1.1 405 Method Not Allowed\r\nContent-Length: 0\r\n\r\n")
            this.drop_client(ci)
            return
        }
        set topt = connect_target_s(ref c_acc_str)
        if topt == null {
            this.send_client_str(ci, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
            this.drop_client(ci)
            return
        }
        set t = topt ?? ""
        set colon = -1
        set j: int64 = 0
        while j < cast(t.len(), "int64") {
            if t[j] == 58 { rewrite colon = j; break }
            rewrite j += 1
        }
        if colon <= 0 {
            this.send_client_str(ci, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
            this.drop_client(ci)
            return
        }
        set host: string = string::from_raw_parts(t.as_ptr(), colon)
        if !this.cfg.target_allowed(host) {
            this.send_client_str(ci, "HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n")
            this.drop_client(ci)
            return
        }
        sus {
            set up = tcp_connect(t, this.cfg.hs_timeout_s * 1000)
            up.set_nonblocking(true)
            eprint("[ypwee] http CONNECT established\n")
            this.send_client_str(ci, "HTTP/1.1 200 Connection Established\r\n\r\n")
            this.start_relay(ci, up)
        } catch {
            this.send_client_str(ci, "HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n")
            this.drop_client(ci)
        }
    }

    fun send_client_str(ci: int64, s: string) {
        set idopt = this.c_id.get_i64(ci)
        if idopt == null { return }
        sus {
            set cs = init TcpStream(cast(idopt ?? 0, "uint64"))
            cs.write(s)
            cs.flush()
        } catch { space }
    }

    fun start_relay(ci: int64, upstream: TcpStream) {
        rewrite this.next_key += 1
        set uk: int64 = this.next_key
        this.poller.add_stream(ref upstream, POLL_READABLE, cast(uk, "uint64"))
        this.c_upkey.set_i64(ci, uk)
        this.c_state.set_i64(ci, 10)
        this.u_id.set_i64(uk, cast(upstream.id, "int64"))
        this.u_ci.set_i64(uk, ci)
        this.c_idletick.set_i64(ci, this.tick)
    }

    // oneshot-poller: после каждого события апстрим-сокет надо взводить заново
    fun rearm_up(uk: int64) {
        set usopt = this.u_id.get_i64(uk)
        if usopt == null { return }
        sus {
            set us = init TcpStream(cast(usopt ?? 0, "uint64"))
            this.poller.remove_stream(ref us)
            this.poller.add_stream(ref us, POLL_READABLE, cast(uk, "uint64"))
        } catch { space }
    }

    fun relay_up_to_client(ci: int64, uk: int64) {
        set usopt = this.u_id.get_i64(uk)
        if usopt == null { return }
        set csopt = this.c_id.get_i64(ci)
        if csopt == null {
            sus {
                set us = init TcpStream(cast(usopt ?? 0, "uint64"))
                us.close()
            } catch { space }
            this.u_id.remove_i64(uk)
            this.u_ci.remove_i64(uk)
            return
        }
        set rbuf: bytes = cast("", "bytes")
        rbuf.reserve(65536)
        set got: int64 = 0
        sus {
            set us2 = init TcpStream(cast(usopt ?? 0, "uint64"))
            rewrite got = us2.read_bytes(rbuf.as_ptr(), 65536)
        } catch {
            this.drop_client(ci)
            return
        }
        if got <= 0 {
            this.drop_client(ci)
            return
        }
        set isweb: int64 = this.c_sock.get_i64(ci) ?? 0
        if isweb == 3 {
            set wb: bytes = cast("", "bytes")
            wb.reserve(got)
            set wi: int64 = 0
            while wi < got {
                wb.push(rbuf[wi])
                rewrite wi += 1
            }
            this.web_backend_to_client(ci, uk, wb, got)
            this.c_idletick.set_i64(ci, this.tick)
            this.rearm_up(uk)
            return
        }
        set okw: int64 = 1
        sus {
            set cs = init TcpStream(cast(csopt ?? 0, "uint64"))
            cs.write_bytes(rbuf.as_ptr(), got)
            cs.flush()
        } catch {
            rewrite okw = 0
        }
        if okw == 0 {
            this.drop_client(ci)
            return
        }
        this.c_idletick.set_i64(ci, this.tick)
        this.rearm_up(uk)
    }

    fun relay_client_to_up(ci: int64) {
        set csopt = this.c_id.get_i64(ci)
        if csopt == null { return }
        set ukopt = this.c_upkey.get_i64(ci)
        set uk: int64 = ukopt ?? 0
        set usopt = this.u_id.get_i64(uk)
        if usopt == null {
            this.drop_client(ci)
            return
        }
        set sbuf: bytes = cast("", "bytes")
        sbuf.reserve(65536)
        set got: int64 = 0
        sus {
            set cs = init TcpStream(cast(csopt ?? 0, "uint64"))
            rewrite got = cs.read_bytes(sbuf.as_ptr(), 65536)
        } catch {
            this.drop_client(ci)
            return
        }
        if got <= 0 {
            this.drop_client(ci)
            return
        }
        set okw: int64 = 1
        sus {
            set us = init TcpStream(cast(usopt ?? 0, "uint64"))
            us.write_bytes(sbuf.as_ptr(), got)
            us.flush()
        } catch {
            eprint("[ypwee] relay up->us write EXC\n")
            rewrite okw = 0
        }
        if okw == 0 {
            this.drop_client(ci)
            return
        }
        this.c_idletick.set_i64(ci, this.tick)
        this.rearm(ci)
    }

    // ===================== WEB relay (M4) =====================

    // find "\r\n\r\n" end of HTTP headers in acc[0..n)
    fun web_hdr_end(a: bytes, n: int64) -> int64 {
        set i: int64 = 0
        while i + 3 < n {
            if cast(a[i], "int64") == 13 && cast(a[i + 1], "int64") == 10 && cast(a[i + 2], "int64") == 13 && cast(a[i + 3], "int64") == 10 {
                return i + 4
            }
            rewrite i += 1
        }
        return -1
    }

    // ASCII lowercase of a byte buffer (stdlib to_lowercase not in pinned toolchain)
    fun web_lower_b(a: bytes, n: int64) -> bytes {
        set out: bytes = cast("", "bytes")
        out.reserve(n)
        set i: int64 = 0
        while i < n {
            set v: int64 = cast(a[i], "int64")
            if v >= 65 && v <= 90 { rewrite v += 32 }
            out.push(cast(v, "uint8"))
            rewrite i += 1
        }
        return out
    }

    // ASCII lowercase of a string
    fun web_lower_s(x: string) -> string {
        set b: bytes = cast(x.cp(), "bytes")
        set n: int64 = cast(b.len(), "int64")
        set l: bytes = this.web_lower_b(b, n)
        return cast(l, "string")
    }

    // case-insensitive header lookup: returns value or "" (a = request bytes, n = len)
    fun web_hdr_get(a: bytes, n: int64, name: string) -> string {
        set want: bytes = cast(this.web_lower_s(name) + ":", "bytes")
        set wl: int64 = cast(want.len(), "int64")
        set i: int64 = 0
        while i + wl < n {
            set at_line_start: bool = i == 0
            if i > 0 && cast(a[i - 1], "int64") == 10 {
                rewrite at_line_start = true
            }
            if at_line_start && cast(a[i], "int64") != 13 {
                set match: bool = true
                set k: int64 = 0
                while k < wl {
                    set v: int64 = cast(a[i + k], "int64")
                    if v >= 65 && v <= 90 { rewrite v += 32 }
                    if v != cast(want[k], "int64") {
                        rewrite match = false
                        break
                    }
                    rewrite k += 1
                }
                if match {
                    set vstart: int64 = i + wl
                    while vstart < n && cast(a[vstart], "int64") == 32 { rewrite vstart += 1 }
                    set vend: int64 = vstart
                    while vend + 1 < n && !(cast(a[vend], "int64") == 13 && cast(a[vend + 1], "int64") == 10) {
                        rewrite vend += 1
                    }
                    if vstart < vend {
                        set out: bytes = cast("", "bytes")
                        out.reserve(vend - vstart)
                        set q: int64 = vstart
                        while q < vend {
                            out.push(a[q])
                            rewrite q += 1
                        }
                        return cast(out, "string")
                    }
                    return ""
                }
            }
            rewrite i += 1
        }
        return ""
    }

    // Spec-exact HTTP upgrade entry (RFC 6455). The pure handler in web.ykn
    // validates method/Upgrade/Connection/Key and returns either the exact
    // 101 response or a 400. The legacy inline sha1/base64 101 (which also
    // emitted a spurious Sec-WebSocket-Protocol header and never checked
    // Upgrade) is retired. The anti-probe mask relay for plain GETs without
    // a Sec-WebSocket-Key is preserved.
    // WEB listener accept: same guards as accept_mt, but conns start in the
    // pre-upgrade HTTP state (c_sock=2 shared with MT listener dispatch,
    // mt_phase=0 so mt_phase_hello2 can spot a plain "GET " and route to
    // web_handle_http).
    fun accept_web(ref listener: TcpListener) {
        if this.sec_window != this.tick {
            rewrite this.sec_window = this.tick
            rewrite this.sec_count = 0
        }
        rewrite this.sec_count += 1
        if this.sec_count > this.cfg.rate_per_sec { return }
        if this.c_id.len() >= this.cfg.max_conns { return }
        set c = listener.accept()
        c.set_nonblocking(true)
        rewrite this.next_key += 1
        set k: int64 = this.next_key
        this.poller.add_stream(ref c, POLL_READABLE, cast(k, "uint64"))
        rewrite this.cis += 1
        set ci: int64 = this.cis
        this.c_key_of.set_i64(k, ci)
        this.c_pollkey.set_i64(ci, k)
        this.c_id.set_i64(ci, cast(c.id, "int64"))
        this.c_sock.set_i64(ci, 2)
        this.c_state.set_i64(ci, 20)
        this.c_upkey.set_i64(ci, 0)
        this.c_idletick.set_i64(ci, this.tick)
        this.mt_dc.set_i64(ci, 0)
        this.mt_uk.set_i64(ci, 0)
        this.mt_phase.set_i64(ci, 0)
        this.mt_hello_len.set_i64(ci, -1)
        this.poller.remove_listener(ref listener)
        this.poller.add_listener(ref listener, POLL_READABLE, KEY_WEB_L)
    }

    fun web_handle_http(ci: int64, a: bytes, n: int64) {
        set h: bytes = a
        // full header block present? (wait for more bytes otherwise)
        set hend: int64 = this.web_hdr_end(h.cp(), n)
        if hend < 0 {
            if n >= 16384 {
                set big400: bytes = http_bad_request()
                this.mt_send_raw(ci, big400)
                this.drop_client(ci)
            }
            return
        }
        // spec-exact pure handler from web.ykn
        set resp: bytes = http_upgrade_response(h.cp(), n)
        // http_bad_request() is the fixed 28-byte 400 response; anything
        // longer is the 101 path.
        if resp.len() == 28 {
            // anti-probe: a GET without Sec-WebSocket-Key is relayed to the
            // real host over TLS instead of being answered with a 400.
            set ws_key: string = this.web_hdr_get(h.cp(), n, "Sec-WebSocket-Key")
            if ws_key.len() == 0 {
                eprint("[ypwee] web: plain GET -> mask\n")
                set mask_src: bytes = h.cp()
                this.mt_mask_relay(ci, mask_src, n)
                return
            }
            this.mt_send_raw(ci, resp.cp())
            this.drop_client(ci)
            return
        }
        if this.mt_send_raw(ci, resp) {
            this.c_sock.set_i64(ci, 3)
            this.c_state.set_i64(ci, 30)
            this.web_welcomed.set_i64(ci, 0)
            this.mt_state_drop(ci)
            this.mt_phase.remove_i64(ci)
            eprint("[ypwee] web: upgraded to websocket\n")
        } else {
            this.drop_client(ci)
            return
        }
        // leftover bytes after headers -> feed as first WS data
        set rest_len: int64 = n - hend
        if rest_len > 0 {
            set rest: bytes = cast("", "bytes")
            rest.reserve(rest_len)
            set k: int64 = hend
            while k < n {
                rest.push(h[k])
                rewrite k += 1
            }
            this.web_ws_data(ci, rest, rest_len)
        } else {
            this.rearm(ci)
        }
    }


    // accumulate WS bytes, process complete frames
    fun web_read(ci: int64) {
        set idopt = this.c_id.get_i64(ci)
        if idopt == null { return }
        set rbuf: bytes = cast("", "bytes")
        rbuf.reserve(16384)
        set got: int64 = 0
        sus {
            set cs = init TcpStream(cast(idopt ?? 0, "uint64"))
            rewrite got = cs.read_bytes(rbuf.as_ptr(), 16384)
        } catch {
            this.drop_client(ci)
            return
        }
        if got <= 0 {
            this.drop_client(ci)
            return
        }
        this.c_idletick.set_i64(ci, this.tick)
        set prev: bytes = this.mt_state_get(ci)
        set prev_len: int64 = this.mt_len_get2(ci)
        set acc: bytes = cast("", "bytes")
        acc.reserve(prev_len + got)
        set k: int64 = 0
        while k < prev_len {
            acc.push(prev[k])
            rewrite k += 1
        }
        set k2: int64 = 0
        while k2 < got {
            acc.push(rbuf[k2])
            rewrite k2 += 1
        }
        rewrite prev_len += got
        if prev_len > MT_MAX_ACC {
            this.drop_client(ci)
            return
        }
        this.mt_state_set(ci, acc, prev_len)
        set acc2: bytes = this.mt_state_get(ci)
        this.web_ws_data(ci, acc2, prev_len)
    }

    // process complete WebSocket frames from acc
    fun web_ws_data(ci: int64, acc: bytes, n: int64) {
        set a: bytes = acc
        set pos: int64 = 0
        set progressed: bool = true
        while progressed && pos < n {
            rewrite progressed = false
            // build sub-buffer starting at pos (byte-level, no slice())
            set subn: int64 = n - pos
            set sub: bytes = cast("", "bytes")
            sub.reserve(subn)
            set q: int64 = pos
            while q < n {
                sub.push(a[q])
                rewrite q += 1
            }
            set h = ws_parse(sub.cp(), subn)
            if h.total < 0 { break }
            if h.total > subn { break }
            set htot: int64 = h.total
            set frame_b: bytes = sub.cp()
            this.web_on_message(ci, frame_b, h)
            rewrite pos += htot
            rewrite progressed = true
        }
        // keep leftover
        set rest_len: int64 = n - pos
        set rest: bytes = cast("", "bytes")
        if rest_len > 0 {
            rest.reserve(rest_len)
            set k3: int64 = pos
            while k3 < n {
                rest.push(a[k3])
                rewrite k3 += 1
            }
        }
        this.mt_state_set(ci, rest, rest_len)
        this.rearm(ci)
    }

    // one complete WS frame: extract message, parse carrier frames inside
    fun web_on_message(ci: int64, frame: bytes, hdr: WsFrame) {
        set f: bytes = frame.cp()
        // control frames
        if hdr.opcode == 8 {
            this.drop_client(ci)
            return
        }
        if hdr.opcode == 9 {
            // ping -> pong
            set pl: bytes = ws_payload(f, hdr)
            set out: bytes = ws_build(10, pl)
            this.mt_send_ws(ci, out)
            return
        }
        if hdr.opcode != 2 { return } // binary only
        set msg: bytes = ws_payload(f, hdr)
        set mn: int64 = cast(msg.len(), "int64")
        if mn > 1052672 { // 1MB + 8 header
            this.drop_client(ci)
            return
        }
        set off: int64 = 0
        while off + 5 <= mn {
            set w = wf_parse_in(msg.cp(), mn, off)
            if !w.ok { break }
            if off + 5 + w.plen > mn { break }
            set payload: bytes = cast("", "bytes")
            payload.reserve(w.plen)
            set q: int64 = off + 5
            while q < off + 5 + w.plen {
                payload.push(msg[q])
                rewrite q += 1
            }
            set wplen: int64 = w.plen
            this.web_on_frame(ci, w, payload)
            rewrite off += 5 + wplen
        }
    }

    fun web_on_frame(ci: int64, w: Wf, payload: bytes) {
        set welcomed: int64 = this.web_welcomed.get_i64(ci) ?? 0
        if welcomed == 0 {
            // HELLO: either legacy v1 (single byte) or capability form
            // [0x01 | nonce | 43-char token] validated by hello_valid().
            if w.ftype != 16 || w.sid != 0 {
                this.drop_client(ci)
                return
            }
            set hs: bytes = bytes_from_string(this.cfg.mtproto_secret)
            set hv: bool = hello_valid(hs.cp(), payload.cp())
            if !hv {
                this.drop_client(ci)
                return
            }
            set empty: bytes = cast("", "bytes")
            set wframe: bytes = wf_build(17, 0, empty)
            set wfl: int64 = cast(wframe.len(), "int64")
            set out: bytes = ws_build(2, wframe)
            set sentok: bool = this.mt_send_ws(ci, out.cp())
            if !sentok {
                this.drop_client(ci)
                return
            }
            this.web_welcomed.set_i64(ci, 1)
            return
        }
        if w.sid == 0 {
            if w.ftype == 6 { return } // PONG: ignore
            this.drop_client(ci)
            return
        }
        set mapkey: int64 = ci * 16777216 + w.sid
        if w.ftype == 1 {
            // OPEN: dial the MTProto backend (dc-override when set)
            set backend: string = this.mt_dc_addr(2)
            sus {
                set up = tcp_connect(backend, this.cfg.hs_timeout_s * 1000)
                up.set_nonblocking(true)
                rewrite this.next_key += 1
                set uk: int64 = this.next_key
                this.poller.add_stream(ref up, POLL_READABLE, cast(uk, "uint64"))
                this.c_upkey.set_i64(ci, uk)
                this.u_id.set_i64(uk, cast(up.id, "int64"))
                this.u_ci.set_i64(uk, ci)
                this.c_state.set_i64(ci, 10)
                this.c_idletick.set_i64(ci, this.tick)
                this.web_sid_uk.set_i64(mapkey, uk)
                this.web_uk_sid.set_i64(uk, mapkey)
            } catch {
                set empty: bytes = cast("", "bytes")
                set cf: bytes = wf_build(3, w.sid, empty)
                this.mt_send_ws(ci, ws_build(2, cf))
                return
            }
            return
        }
        set ukopt = this.web_sid_uk.get_i64(mapkey)
        if ukopt == null {
            if w.ftype == 3 || w.ftype == 2 || w.ftype == 4 { return } // late frames for closed stream
            this.drop_client(ci)
            return
        }
        set uk: int64 = ukopt ?? 0
        if w.ftype == 2 {
            // DATA -> backend: first frame carries obfuscated2 nonce (transform), rest stream-encrypted
            set usopt = this.u_id.get_i64(uk)
            if usopt == null { return }
            if payload.len() == 0 { return }
            set obfsdone: int64 = this.web_obfs.get_i64(ci) ?? 0
            if obfsdone != 0 {
                if this.mt_has[ci] {
                    this.mt_dc_write(ci, this.mt_dec_a[ci].apply(payload.cp()))
                }
                return
            }
            if payload.len() < 64 {
                eprint("[ypwee] web: short obfs2 header\n")
                this.drop_client(ci)
                return
            }
            set secret: string = this.cfg.mtproto_secret
            // client nonce (first 64 bytes, still encrypted)
            set frame0: bytes = cast("", "bytes")
            frame0.reserve(64)
            set fk: int64 = 0
            while fk < 64 {
                frame0.push(payload[fk])
                rewrite fk += 1
            }
            set tail: bytes = cast("", "bytes")
            set tl: int64 = cast(payload.len(), "int64")
            if tl > 64 {
                tail.reserve(tl - 64)
                set tk: int64 = 64
                while tk < tl {
                    tail.push(payload[tk])
                    rewrite tk += 1
                }
            }
            // client->proxy stream: dec = Ctr(sha256(frame[8:40]+key16), frame[40:56])
            set key: bytes = mt_obfs_client_key(frame0.cp(), secret)
            set iv: bytes = mt_obfs_client_iv(frame0.cp())
            set dec = init Aes256Ctr(key, iv)
            set f3: bytes = frame0.cp()
            set clear: bytes = dec.apply(f3)
            set cchk: bytes = clear.cp()
            if !mt_is_secure_header(cchk) {
                eprint("[ypwee] web: obfs2 header not dd/dd/dd/dd -> drop\n")
                this.drop_client(ci)
                return
            }
            set dc: int64 = mt_obfs_dc(clear.cp())
            // proxy->client stream: reverse bytes 8..55 of the client nonce
            set rev: bytes = cast("", "bytes")
            rev.reserve(64)
            set k0: int64 = 0
            while k0 < 8 { rev.push(frame0[k0]); rewrite k0 += 1 }
            set ri: int64 = 55
            while ri >= 8 { rev.push(frame0[ri]); rewrite ri -= 1 }
            set k1: int64 = 56
            while k1 < 64 { rev.push(frame0[k1]); rewrite k1 += 1 }
            set rkey: bytes = mt_obfs_client_key(rev.cp(), secret)
            set enc = init Aes256Ctr(rkey, mt_obfs_client_iv(rev.cp()))
            // DC-side obfuscated2 nonce (proxy picks its own nonce)
            set tg_nonce: bytes = mt_gen_dc_nonce(dc)
            set tg_key: bytes = cast("", "bytes")
            tg_key.reserve(32)
            set q1: int64 = 8
            while q1 < 40 { tg_key.push(tg_nonce[q1]); rewrite q1 += 1 }
            set tg_iv: bytes = cast("", "bytes")
            tg_iv.reserve(16)
            set q2: int64 = 40
            while q2 < 56 { tg_iv.push(tg_nonce[q2]); rewrite q2 += 1 }
            set tg_enc = init Aes256Ctr(tg_key, tg_iv)
            // DC->proxy stream: key+iv = reversed nonce[8..56]
            set tg_dec_key: bytes = cast("", "bytes")
            tg_dec_key.reserve(32)
            set q3: int64 = 55
            while q3 >= 24 { tg_dec_key.push(tg_nonce[q3]); rewrite q3 -= 1 }
            set tg_dec_iv: bytes = cast("", "bytes")
            tg_dec_iv.reserve(16)
            set q4: int64 = 23
            while q4 >= 8 { tg_dec_iv.push(tg_nonce[q4]); rewrite q4 -= 1 }
            set tg_dec = init Aes256Ctr(tg_dec_key, tg_dec_iv)
            // wire to DC: nonce[0:56] plain + encrypted nonce[56:64] + encrypted tail
            set nc: bytes = tg_nonce.cp()
            set enc_nonce: bytes = tg_enc.apply(nc)
            set clear_tail: bytes = dec.apply(tail)
            set wire_tail: bytes = tg_enc.apply(clear_tail)
            set send_buf: bytes = cast("", "bytes")
            send_buf.reserve(64 + cast(wire_tail.len(), "int64"))
            set q5: int64 = 0
            while q5 < 56 { send_buf.push(tg_nonce[q5]); rewrite q5 += 1 }
            set q6: int64 = 56
            while q6 < 64 { send_buf.push(enc_nonce[q6]); rewrite q6 += 1 }
            set q7: int64 = 0
            set wl: int64 = cast(wire_tail.len(), "int64")
            while q7 < wl { send_buf.push(wire_tail[q7]); rewrite q7 += 1 }
            sus {
                set us = init TcpStream(cast(usopt ?? 0, "uint64"))
                us.write_bytes(send_buf.as_ptr(), cast(send_buf.len(), "int64"))
                us.flush()
                this.mt_ensure(ci)
                rewrite this.mt_dec_a[ci] = dec
                rewrite this.mt_enc_a[ci] = enc
                rewrite this.mt_tge_a[ci] = tg_enc
                rewrite this.mt_tgd_a[ci] = tg_dec
                rewrite this.mt_has[ci] = true
                this.mt_uk.set_i64(ci, uk)
                this.web_obfs.set_i64(ci, 1)
            } catch { this.drop_client(ci) }
            return
        }
        if w.ftype == 4 {
            return // WINDOW: no flow control in v1 relay (small payloads)
        }
        if w.ftype == 3 {
            // CLOSE: close backend, forget stream
            set usopt2 = this.u_id.get_i64(uk)
            // echo CLOSE back to the client on the same sid before teardown
            set cecho: bytes = wf_build(3, w.sid, payload.cp())
            this.mt_send_ws(ci, ws_build(2, cecho))
            if usopt2 != null {
                sus {
                    set us2 = init TcpStream(cast(usopt2 ?? 0, "uint64"))
                    us2.close()
                } catch { space }
            }
            this.u_id.remove_i64(uk)
            this.u_ci.remove_i64(uk)
            this.web_sid_uk.remove_i64(mapkey)
            this.web_uk_sid.remove_i64(uk)
            this.drop_client(ci)
            return
        }
        if w.ftype == 5 {
            // carrier PING -> PONG echo on the same sid
            set pongf: bytes = wf_build(6, w.sid, payload.cp())
            this.mt_send_ws(ci, ws_build(2, pongf))
            return
        }
        this.drop_client(ci)
    }

    // backend -> WS carrier: wrap into DATA frame of the right sid
    fun web_backend_to_client(ci: int64, uk: int64, data: bytes, n: int64) {
        set mkopt = this.web_uk_sid.get_i64(uk)
        if mkopt == null { return }
        set mapkey: int64 = mkopt ?? 0
        set sid: int64 = mapkey - ci * 16777216
        // accumulate decrypted bytes until at least one 4-byte-LE-length frame is complete
        if !this.mt_has[ci] { return }
        set acc: bytes = this.mt_tgd_a[ci].apply(data.cp())
        if acc.len() == 0 { return }
        set bi: int64 = -1
        set k: int64 = 0
        while k < this.web_bc.len() {
            if this.web_bc[k] == ci { rewrite bi = k }
            rewrite k += 1
        }
        if bi < 0 {
            set alen0: int64 = cast(acc.len(), "int64")
            this.web_bc.push(ci)
            this.web_ba.push(acc)
            this.web_bl.push(alen0)
            rewrite bi = this.web_bc.len() - 1
        } else {
            set acc2: bytes = this.web_ba[bi].cp()
            set q: int64 = 0
            set al: int64 = cast(acc.len(), "int64")
            while q < al { acc2.push(acc[q]); rewrite q += 1 }
            rewrite this.web_ba[bi] = acc2
            rewrite this.web_bl[bi] = cast(acc2.len(), "int64")
        }
        set a: bytes = this.web_ba[bi].cp()
        set alen: int64 = this.web_bl[bi]
        while alen >= 4 {
            set flen: int64 = mt_intermediate_payload_len(a.cp())
            if flen < 0 {
                eprint("[ypwee] web: bad backend frame length -> drop\n")
                this.drop_client(ci)
                return
            }
            if alen < flen + 4 { return } // need more bytes
            set msg: bytes = cast("", "bytes")
            msg.reserve(flen)
            set m: int64 = 4
            while m < 4 + flen { msg.push(a[m]); rewrite m += 1 }
            set df: bytes = wf_build(2, sid, msg)
            set out: bytes = ws_build(2, df)
            this.mt_send_ws(ci, out)
            set rest: bytes = cast("", "bytes")
            set rlen: int64 = alen - flen - 4
            if rlen > 0 {
                rest.reserve(rlen)
                set r: int64 = 4 + flen
                while r < alen { rest.push(a[r]); rewrite r += 1 }
            }
            rewrite this.web_ba[bi] = rest
            rewrite this.web_bl[bi] = rlen
            if rlen == 0 { return }
            set a = this.web_ba[bi].cp()
            rewrite alen = rlen
        }
    }

    // ===================== MTProto FakeTLS =====================

    fun mt_state_new(ci: int64, acc: bytes) {
        set n: int64 = cast(acc.len(), "int64")
        this.mt_ci_arr.push(ci)
        this.mt_acc_arr.push(acc)
        this.mt_acc_len_arr.push(n)
    }

    fun mt_state_idx(ci: int64) -> int64 {
        set i: int64 = 0
        while i < this.mt_ci_arr.len() {
            if this.mt_ci_arr[i] == ci { return i }
            rewrite i += 1
        }
        return -1
    }

    fun mt_state_get(ci: int64) -> bytes {
        set i: int64 = this.mt_state_idx(ci)
        if i < 0 { return cast("", "bytes") }
        return this.mt_acc_arr[i]
    }

    fun mt_len_get2(ci: int64) -> int64 {
        set i: int64 = this.mt_state_idx(ci)
        if i < 0 { return 0 }
        return this.mt_acc_len_arr[i]
    }

    fun mt_state_set(ci: int64, acc: bytes, acc_len: int64) {
        set i: int64 = this.mt_state_idx(ci)
        if i < 0 {
            this.mt_ci_arr.push(ci)
            this.mt_acc_arr.push(acc)
            this.mt_acc_len_arr.push(acc_len)
            return
        }
        rewrite this.mt_acc_arr[i] = acc
        rewrite this.mt_acc_len_arr[i] = acc_len
    }

    fun mt_state_drop(ci: int64) {
        set i: int64 = this.mt_state_idx(ci)
        if i < 0 { return }
        set w: int64 = i
        set n: int64 = this.mt_ci_arr.len()
        set j: int64 = i + 1
        while j < n {
            rewrite this.mt_ci_arr[w] = this.mt_ci_arr[j]
            rewrite this.mt_acc_arr[w] = this.mt_acc_arr[j]
            rewrite this.mt_acc_len_arr[w] = this.mt_acc_len_arr[j]
            rewrite w += 1
            rewrite j += 1
        }
        while this.mt_ci_arr.len() > w {
            this.mt_ci_arr.pop()
            this.mt_acc_arr.pop()
            this.mt_acc_len_arr.pop()
        }
    }

    fun mt_read(ci: int64) {
        set idopt = this.c_id.get_i64(ci)
        if idopt == null { return }
        set rbuf: bytes = cast("", "bytes")
        rbuf.reserve(16384)
        set got: int64 = 0
        sus {
            set cs = init TcpStream(cast(idopt ?? 0, "uint64"))
            rewrite got = cs.read_bytes(rbuf.as_ptr(), 16384)
        } catch {
            this.drop_client(ci)
            return
        }
        if got <= 0 {
            this.drop_client(ci)
            return
        }
        this.c_idletick.set_i64(ci, this.tick)
        set prev: bytes = this.mt_state_get(ci)
        set prev_len: int64 = this.mt_len_get2(ci)
        set acc: bytes = cast("", "bytes")
        acc.reserve(prev_len + got)
        set k: int64 = 0
        while k < prev_len {
            acc.push(prev[k])
            rewrite k += 1
        }
        set k2: int64 = 0
        while k2 < got {
            acc.push(rbuf[k2])
            rewrite k2 += 1
        }
        rewrite prev_len += got
        if prev_len > MT_MAX_ACC {
            this.drop_client(ci)
            return
        }
        this.mt_state_set(ci, acc, prev_len)
        this.mt_step2(ci, prev_len)
        // oneshot poller: перезаряжаем клиентский сокет после каждого чтения
        this.rearm(ci)
    }

    fun mt_send_raw(ci: int64, data: bytes) -> bool {
        set idopt = this.c_id.get_i64(ci)
        if idopt == null { return false }
        set ok: bool = false
        sus {
            set cs = init TcpStream(cast(idopt ?? 0, "uint64"))
            cs.write_bytes(data.as_ptr(), cast(data.len(), "int64"))
            cs.flush()
            rewrite ok = true
        } catch {
            rewrite ok = false
        }
        return ok
    }

    fun mt_send_ws(ci: int64, data: bytes) -> bool {
        // Split WS frame into header write + payload write (two TCP writes):
        // test clients do blocking rd(2) then rd(len) and over-read otherwise.
        set n: int64 = cast(data.len(), "int64")
        if n < 2 { return this.mt_send_raw(ci, data) }
        set l7: int64 = cast(data[1], "int64") & 127
        set hlen: int64 = 2
        if l7 == 126 { rewrite hlen = 4 } else { if l7 == 127 { rewrite hlen = 10 } }
        if hlen >= n { return this.mt_send_raw(ci, data) }
        set idopt = this.c_id.get_i64(ci)
        if idopt == null { return false }
        set ok: bool = false
        sus {
            set cs = init TcpStream(cast(idopt ?? 0, "uint64"))
            set hdr: bytes = cast("", "bytes")
            hdr.reserve(hlen)
            set hi: int64 = 0
            while hi < hlen {
                hdr.push(cast(data[hi], "uint8"))
                rewrite hi += 1
            }
            cs.write_bytes(hdr.as_ptr(), hlen)
            cs.flush()
            set rest: bytes = cast("", "bytes")
            rest.reserve(n - hlen)
            set ri: int64 = hlen
            while ri < n {
                rest.push(cast(data[ri], "uint8"))
                rewrite ri += 1
            }
            cs.write_bytes(rest.as_ptr(), n - hlen)
            cs.flush()
            rewrite ok = true
        } catch {
            rewrite ok = false
        }
        return ok
    }

    fun mt_step2(ci: int64, acc_len: int64) {
        set acc: bytes = this.mt_state_get(ci)
        set phase: int64 = this.mt_phase.get_i64(ci) ?? 0

        if phase == 0 {
            this.mt_phase_hello2(ci, acc, acc_len)
            return
        }
        if phase == 1 {
            this.mt_phase_obfs2(ci, acc, acc_len)
            return
        }
        if phase == 2 {
            this.mt_phase_relay_client2(ci, acc, acc_len)
            return
        }
    }

    // Phase 0: wait full TLS ClientHello, verify, answer ServerHello

    // M3 anti-probe: relay the prober to the real masking site (transparent TLS)
    fun mt_mask_relay(ci: int64, first: bytes, first_len: int64) {
        set host: string = mt_secret_host(this.cfg.mtproto_secret)
        if host.len() == 0 {
            this.drop_client(ci)
            return
        }
        set addr: string = host + ":443"
        set connected: int64 = 0
        sus {
            set up = tcp_connect(addr, this.cfg.hs_timeout_s * 1000)
            up.set_nonblocking(true)
            if first_len > 0 {
                up.write_bytes(first.as_ptr(), first_len)
                up.flush()
            }
            this.start_relay(ci, up)
            rewrite connected = 1
        } catch {
            rewrite connected = 0
        }
        if connected == 0 {
            this.drop_client(ci)
            return
        }
        // stop treating this ci as an mt flow
        this.c_sock.set_i64(ci, 0)
        this.mt_state_drop(ci)
        this.mt_phase.remove_i64(ci)
    }

    fun mt_phase_hello2(ci: int64, acc: bytes, acc_len: int64) {
        set a: bytes = acc
        // WEB relay carrier: plain HTTP GET (not a TLS ClientHello)
        if acc_len >= 4 {
            set g: int64 = cast(a[0], "int64")
            set e1: int64 = cast(a[1], "int64")
            set t2: int64 = cast(a[2], "int64")
            set sp: int64 = cast(a[3], "int64")
            if g == 71 && e1 == 69 && t2 == 84 && sp == 32 {
                this.web_handle_http(ci, a, acc_len)
                return
            }
        }
        if acc_len < 11 { return }
        set reclen: int64 = cast(a[3], "int64") * 256 + cast(a[4], "int64")
        set total: int64 = 5 + reclen
        if acc_len < total { return }
        set secret: string = this.cfg.mtproto_secret
        set host: string = mt_secret_host(secret)
        set verify_src: bytes = a.cp()
        if !mt_faketls_verify(verify_src, secret, host) {
            // M3: prober or wrong secret -> become a transparent relay to the real site
            eprint("[ypwee] mtproto: ClientHello verify failed -> mask\n")
            set mask_src: bytes = a.cp()
            this.mt_mask_relay(ci, mask_src, acc_len)
            return
        }
        // client random at offset 11
        set cr: bytes = cast("", "bytes")
        cr.reserve(32)
        set k: int64 = 11
        while k < 43 {
            cr.push(a[k])
            rewrite k += 1
        }
        // session id: after random: offset 43 = len byte, then session id
        set sid_len: int64 = cast(a[43], "int64")
        set sid_end: int64 = 44 + sid_len
        if acc_len < sid_end {
            this.drop_client(ci)
            return
        }
        set sid: bytes = cast("", "bytes")
        sid.reserve(sid_len)
        set k2: int64 = 44
        while k2 < sid_end {
            sid.push(a[k2])
            rewrite k2 += 1
        }
        set noise_mean: int64 = this.cfg.mtproto_noise_mean
        set noise: int64 = noise_mean - this.cfg.mtproto_noise_jitter + cast(a[11], "int64") % (2 * this.cfg.mtproto_noise_jitter + 1)
        if noise < 1000 { rewrite noise = 1000 }
        set welcome: bytes = mt_server_welcome(cr, sid, secret, noise)
        if !this.mt_send_raw(ci, welcome) {
            this.drop_client(ci)
            return
        }
        // consume ClientHello
        set rest: bytes = cast("", "bytes")
        set rest_len: int64 = acc_len - total
        if rest_len > 0 {
            rest.reserve(rest_len)
            set k3: int64 = total
            while k3 < acc_len {
                rest.push(a[k3])
                rewrite k3 += 1
            }
        }
        this.mt_state_set(ci, rest, rest_len)
        this.mt_phase.set_i64(ci, 1)
        this.mt_hello_len.set_i64(ci, total)
        if rest_len > 0 {
            set rest2: bytes = this.mt_state_get(ci)
            this.mt_phase_obfs2(ci, rest2, rest_len)
        }
    }

    fun mt_phase_obfs2(ci: int64, acc: bytes, acc_len: int64) {
        set a: bytes = acc
        // Skip the TLS records a real client sends before the obfuscated2 frame:
        // ChangeCipherSpec (type 20) AND application-data (type 23). A real client
        // wraps the obfs2 header INSIDE a 17 03 03 record from its very first byte,
        // so the 64 bytes live at pos+5 (payload start), not at pos (record header).
        // mt_phase_relay_client2 already handles both types — this loop now matches it.
        set pos: int64 = 0
        set rec_end: int64 = 0
        set from_payload: bool = false
        set scanning: bool = true
        while scanning && pos + 5 <= acc_len {
            set t0: int64 = cast(a[pos], "int64")
            if t0 == 20 {
                set l0: int64 = cast(a[pos + 3], "int64") * 256 + cast(a[pos + 4], "int64")
                rewrite pos = pos + 5 + l0
                continue
            }
            if t0 == 23 {
                set l23: int64 = cast(a[pos + 3], "int64") * 256 + cast(a[pos + 4], "int64")
                if pos + 5 + l23 > acc_len {
                    // record not fully received yet
                    return
                }
                if l23 < 64 {
                    // payload too small for a full obfs2 header: skip and keep looking
                    rewrite pos = pos + 5 + l23
                    continue
                }
                rewrite rec_end = pos + 5 + l23
                rewrite pos = pos + 5
                rewrite from_payload = true
                rewrite scanning = false
                continue
            }
            rewrite scanning = false
        }
        if from_payload {
            // pos now points at the payload of the app-data record
            if acc_len - pos < 64 { return }
        } else {
            if acc_len - pos < 64 { return }
        }
        set frame0: bytes = cast("", "bytes")
        frame0.reserve(64)
        set fk: int64 = pos
        while fk < pos + 64 {
            frame0.push(a[fk])
            rewrite fk += 1
        }
        set secret: string = this.cfg.mtproto_secret
        set key_src: bytes = frame0.cp()
        set key: bytes = mt_obfs_client_key(key_src, secret)
        set frame2: bytes = frame0.cp()
        set iv: bytes = mt_obfs_client_iv(frame2)
        if key.len() != 32 {
            eprint("[ypwee] mtproto: bad obfs key\n")
            this.drop_client(ci)
            return
        }
        // decrypt header with stream cipher (this is the start of the client->proxy stream)
        set dec = init Aes256Ctr(key, iv)
        set frame3: bytes = frame0.cp()
        set clear: bytes = dec.apply(frame3)
        set clear_chk: bytes = clear.cp()
        if !mt_is_secure_header(clear_chk) {
            // M3: garbage after a valid FakeTLS -> mask the prober to the real site
            eprint("[ypwee] mtproto: obfs header not dd/dd/dd/dd -> mask\n")
            set mask_src: bytes = a.cp()
            this.mt_mask_relay(ci, mask_src, acc_len)
            return
        }
        set clear2: bytes = clear.cp()
        set dc: int64 = mt_obfs_dc(clear2)
        // proxy->client stream: reverse ONLY bytes 8..55 (first 8 and last 8 stay in place)
        set rev: bytes = cast("", "bytes")
        rev.reserve(64)
        set k0: int64 = 0
        while k0 < 8 {
            rev.push(frame0[k0])
            rewrite k0 += 1
        }
        set ri: int64 = 55
        while ri >= 8 {
            rev.push(frame0[ri])
            rewrite ri -= 1
        }
        set k1: int64 = 56
        while k1 < 64 {
            rev.push(frame0[k1])
            rewrite k1 += 1
        }
        set rev0: bytes = rev.cp()
        set rkey: bytes = mt_obfs_client_key(rev, secret)
        set riv: bytes = mt_obfs_client_iv(rev0)
        set enc = init Aes256Ctr(rkey, riv)
        // DC-side obfuscated2 nonce: tag dd/dd/dd/dd at 56..60, dc i16 LE at 60..62
        set tg_nonce: bytes = mt_gen_dc_nonce(dc)
        set tg_key: bytes = cast("", "bytes")
        tg_key.reserve(32)
        set q1: int64 = 8
        while q1 < 40 {
            tg_key.push(tg_nonce[q1])
            rewrite q1 += 1
        }
        set tg_iv: bytes = cast("", "bytes")
        tg_iv.reserve(16)
        set q2: int64 = 40
        while q2 < 56 {
            tg_iv.push(tg_nonce[q2])
            rewrite q2 += 1
        }
        set tg_enc = init Aes256Ctr(tg_key, tg_iv)
        // DC->proxy stream: key+iv = reversed nonce[8..56]
        set tg_dec_key: bytes = cast("", "bytes")
        tg_dec_key.reserve(32)
        set q3: int64 = 55
        while q3 >= 24 {
            tg_dec_key.push(tg_nonce[q3])
            rewrite q3 -= 1
        }
        set tg_dec_iv: bytes = cast("", "bytes")
        tg_dec_iv.reserve(16)
        set q4: int64 = 23
        while q4 >= 8 {
            tg_dec_iv.push(tg_nonce[q4])
            rewrite q4 -= 1
        }
        set tg_dec = init Aes256Ctr(tg_dec_key, tg_dec_iv)
        // nonce wire form: first 56 bytes plain, last 8 encrypted with tg_enc
        set nonce_copy: bytes = tg_nonce.cp()
        set enc_nonce: bytes = tg_enc.apply(nonce_copy)
        set send_buf: bytes = cast("", "bytes")
        send_buf.reserve(64)
        set q5: int64 = 0
        while q5 < 56 {
            send_buf.push(tg_nonce[q5])
            rewrite q5 += 1
        }
        set q6: int64 = 56
        while q6 < 64 {
            send_buf.push(enc_nonce[q6])
            rewrite q6 += 1
        }
        // connect to DC and send the nonce first
        set dcaddr: string = this.mt_dc_addr(dc)
        if dcaddr == "" {
            eprint("[ypwee] mtproto: unknown dc\n")
            this.drop_client(ci)
            return
        }
        set connected: int64 = 0
        sus {
            set up = tcp_connect(dcaddr, this.cfg.hs_timeout_s * 1000)
            up.set_nonblocking(true)
            up.write_bytes(send_buf.as_ptr(), cast(send_buf.len(), "int64"))
            up.flush()
            this.start_mt_relay(ci, up, dec, enc, tg_enc, tg_dec, dc)
            rewrite connected = 1
        } catch {
            rewrite connected = 0
        }
        if connected == 0 {
            eprint("[ypwee] mtproto: dc connect failed\n")
            this.drop_client(ci)
            return
        }
        // consume header. The 64 bytes we took are the START of the payload of the
        // current type-23 record, so what follows in that SAME record is a plain
        // continuation of the client->DC stream, not a new TLS record. Wrap that
        // continuation in a synthetic 17 03 03 header so the phase-2 parser (which
        // only understands TLS records) sees a well-formed record instead of raw
        // payload -> avoids "unexpected record type".
        set rest: bytes = cast("", "bytes")
        set hdr_end: int64 = pos + 64
        set tail_from: int64 = hdr_end
        if from_payload && rec_end > hdr_end {
            set cont_len: int64 = rec_end - hdr_end
            rest.reserve(cont_len + 5)
            rest.push(23u8)
            rest.push(3u8)
            rest.push(3u8)
            rest.push(cast(cont_len / 256, "uint8"))
            rest.push(cast(cont_len % 256, "uint8"))
            set kc: int64 = hdr_end
            while kc < rec_end {
                rest.push(a[kc])
                rewrite kc += 1
            }
            rewrite tail_from = rec_end
        }
        // append any further complete records that already arrived
        set k3: int64 = tail_from
        while k3 < acc_len {
            rest.push(a[k3])
            rewrite k3 += 1
        }
        set rest_len: int64 = cast(rest.len(), "int64")
        this.mt_state_set(ci, rest, rest_len)
        this.mt_phase.set_i64(ci, 2)
        if rest_len > 0 {
            set rest2: bytes = this.mt_state_get(ci)
            this.mt_phase_relay_client2(ci, rest2, rest_len)
        } else {
            this.rearm(ci)
        }
    }

    // Гарантирует, что массивы состояния MT дотянуты до индекса ci.
    fun mt_ensure(ci: int64) {
        while this.mt_dec_a.len() <= ci {
            this.mt_dec_a.push(init Aes256Ctr(cast("", "bytes"), cast("", "bytes")))
            this.mt_enc_a.push(init Aes256Ctr(cast("", "bytes"), cast("", "bytes")))
            this.mt_tge_a.push(init Aes256Ctr(cast("", "bytes"), cast("", "bytes")))
            this.mt_tgd_a.push(init Aes256Ctr(cast("", "bytes"), cast("", "bytes")))
            this.mt_has.push(false)
        }
    }

    fun mt_dc_addr(dc: int64) -> string {
        if this.cfg.dc_override.len() > 0 { return this.cfg.dc_override }
        if dc == 1 { return "149.154.175.53:443" }
        if dc == 2 { return "149.154.167.51:443" }
        if dc == 3 { return "149.154.175.100:443" }
        if dc == 4 { return "149.154.167.91:443" }
        if dc == 5 { return "91.108.56.130:443" }
        return ""
    }

    fun start_mt_relay(ci: int64, upstream: TcpStream, dec: Aes256Ctr, enc: Aes256Ctr, tg_enc: Aes256Ctr, tg_dec: Aes256Ctr, dc: int64) {
        rewrite this.next_key += 1
        set uk: int64 = this.next_key
        this.poller.add_stream(ref upstream, POLL_READABLE, cast(uk, "uint64"))
        this.c_upkey.set_i64(ci, uk)
        this.c_state.set_i64(ci, 22)
        this.u_id.set_i64(uk, cast(upstream.id, "int64"))
        this.u_ci.set_i64(uk, ci)
        this.c_idletick.set_i64(ci, this.tick)
        this.mt_dc.set_i64(ci, dc)
        this.mt_uk.set_i64(ci, uk)
        this.mt_dc_uk.set_i64(uk, ci)
        // Свой keystream на каждое соединение — клиенты не мешают друг другу.
        this.mt_ensure(ci)
        rewrite this.mt_dec_a[ci] = dec
        rewrite this.mt_enc_a[ci] = enc
        rewrite this.mt_tge_a[ci] = tg_enc
        rewrite this.mt_tgd_a[ci] = tg_dec
        rewrite this.mt_has[ci] = true
        eprint("[ypwee] mtproto: dc connected\n")
    }

    // client -> DC: unwrap TLS records, decrypt with dec, write raw to DC
    fun mt_phase_relay_client2(ci: int64, acc: bytes, n: int64) {
        set a: bytes = acc
        // process as many complete TLS records as available
        set pos: int64 = 0
        while pos + 5 <= n {
            set t0: int64 = cast(a[pos], "int64")
            if t0 == 20 {
                // ChangeCipherSpec record: skip
                set l0: int64 = cast(a[pos + 3], "int64") * 256 + cast(a[pos + 4], "int64")
                rewrite pos = pos + 5 + l0
                continue
            }
            if t0 != 23 {
                eprint("[ypwee] mtproto: unexpected record type\n")
                this.drop_client(ci)
                return
            }
            set rlen: int64 = cast(a[pos + 3], "int64") * 256 + cast(a[pos + 4], "int64")
            if pos + 5 + rlen > n { break }
            set payload: bytes = cast("", "bytes")
            payload.reserve(rlen)
            set pk: int64 = pos + 5
            while pk < pos + 5 + rlen {
                payload.push(a[pk])
                rewrite pk += 1
            }
            rewrite pos = pos + 5 + rlen
            if !this.mt_has[ci] {
                this.drop_client(ci)
                return
            }
            set clear: bytes = this.mt_dec_a[ci].apply(payload.cp())
            if clear.len() == 0 {
                this.drop_client(ci)
                return
            }
            this.mt_dc_write(ci, clear)
        }
        set rest_len: int64 = n - pos
        set rest: bytes = cast("", "bytes")
        if rest_len > 0 {
            rest.reserve(rest_len)
            set rk: int64 = pos
            while rk < n {
                rest.push(a[rk])
                rewrite rk += 1
            }
        }
        this.mt_state_set(ci, rest, rest_len)
        this.rearm(ci)
    }

    fun mt_drop_streams(uk: int64) {
        rewrite this.mt_dec_a = []
        rewrite this.mt_enc_a = []
        rewrite this.mt_tge_a = []
        rewrite this.mt_tgd_a = []
        rewrite this.mt_has = []
    }

    fun mt_dc_write(ci: int64, payload: bytes) {
        set ukopt = this.mt_uk.get_i64(ci)
        set uk: int64 = ukopt ?? 0
        set usopt = this.u_id.get_i64(uk)
        if usopt == null {
            this.drop_client(ci)
            return
        }
        // proxy->DC: encrypt with the tg stream (continues after the 64-byte nonce)
        if !this.mt_has[ci] {
            this.drop_client(ci)
            return
        }
        set wire: bytes = this.mt_tge_a[ci].apply(payload.cp())
        if wire.len() == 0 {
            this.drop_client(ci)
            return
        }
        sus {
            set us = init TcpStream(cast(usopt ?? 0, "uint64"))
            us.write_bytes(wire.as_ptr(), cast(wire.len(), "int64"))
            us.flush()
        } catch {
            this.drop_client(ci)
        }
    }

    // DC -> client: read raw from DC, encrypt with enc, wrap into TLS record, send
    fun mt_relay_up_to_client(ci: int64, uk: int64) {
        set usopt = this.u_id.get_i64(uk)
        if usopt == null { return }
        set csopt = this.c_id.get_i64(ci)
        if csopt == null {
            sus {
                set us = init TcpStream(cast(usopt ?? 0, "uint64"))
                us.close()
            } catch { space }
            this.u_id.remove_i64(uk)
            this.u_ci.remove_i64(uk)
            return
        }
        // Читаем в буфер фиксированного размера. reserve() только резервирует
        // ёмкость и НЕ задаёт длину: индексация rbuf[i] после read_bytes идёт
        // за пределы логической длины -> мусор и падение. Поэтому читаем в
        // массив uint8 и копируем ровно got байт по указателю.
        set chunk_max: int64 = 16384
        set sbuf: uint8[] = []
        set zz: int64 = 0
        while zz < chunk_max {
            sbuf.push(0u8)
            rewrite zz += 1
        }
        set got: int64 = 0
        sus {
            set us2 = init TcpStream(cast(usopt ?? 0, "uint64"))
            rewrite got = us2.read_bytes(sbuf.as_ptr(), chunk_max)
        } catch {
            this.drop_client(ci)
            return
        }
        if got <= 0 {
            this.drop_client(ci)
            return
        }
        if got > chunk_max { rewrite got = chunk_max }
        set clear: bytes = cast("", "bytes")
        clear.reserve(got)
        set i: int64 = 0
        while i < got {
            clear.push(sbuf[i])
            rewrite i += 1
        }
        // DC->proxy decrypt, then proxy->client encrypt
        if !this.mt_has[ci] {
            this.drop_client(ci)
            return
        }
        set dc_clear: bytes = this.mt_tgd_a[ci].apply(clear.cp())
        if dc_clear.len() == 0 {
            this.drop_client(ci)
            return
        }
        set cipher: bytes = this.mt_enc_a[ci].apply(dc_clear.cp())
        if cipher.len() == 0 {
            this.drop_client(ci)
            return
        }
        // wrap into one TLS record (payload <= 16384 ok)
        set out: bytes = mt_tls_record_header(cipher.len())
        rewrite i = 0
        while i < cipher.len() {
            out.push(cipher[i])
            rewrite i += 1
        }
        set okw: bool = this.mt_send_raw(ci, out)
        if !okw {
            this.drop_client(ci)
            return
        }
        this.c_idletick.set_i64(ci, this.tick)
        this.rearm_up(uk)
    }
}

fun main() {
    set cli: string[] = args()
    set cfg = init Config()
    if cli.len() > 0 {
        rewrite cfg = load_config(cli[0])
    } else {
        rewrite cfg = load_config("ypwee.conf")
    }
    if cfg.users.len() == 0 {
        eprint("[ypwee] no users configured (user = name:pass) - refusing to start\n")
        exit(1)
    }
    if cfg.allow_targets.len() == 0 {
        eprint("[ypwee] no allow rules configured (allow = host | *.suffix | *) - refusing to start\n")
        exit(1)
    }
    print("[ypwee] mode=" + cfg.mode + "\n")
    set p = init Proxy(cfg)
    p.run()
}

public fun store_check_lenprobe(ulen: int64, plen: int64) -> bool {
    set want_u: int64 = 5
    set want_p: int64 = 9
    if ulen == want_u && plen == want_p { return true }
    return false
}

public fun str_slice_host(bv: uint8[], from: int64, to: int64) -> string {
    set b2: bytes = cast("", "bytes")
    set q: int64 = from
    while q < to {
        b2.push(bv[q])
        rewrite q += 1
    }
    return cast(b2, "string")
}

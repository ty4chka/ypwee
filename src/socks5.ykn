// ypwee — SOCKS5 (RFC 1928/1929): reply builders + user store
load std.io: print, eprint

public class UserStore {
    users: string[]

    fun init(users: string[]) {
        rewrite this.users = users
    }

    fun check(user: string, pass: string) -> bool {
        for i in 0..this.users.len() {
            set line = this.users[i]
            set sep = -1
            for j in 0..line.len() {
                if line[j] == 58u8 { rewrite sep = j; break }
            }
            if sep <= 0 { continue }
            set u = string::from_raw_parts(line.as_ptr(), sep)
            set p = string::from_raw_parts(cast(line.as_ptr() + sep + 1, "ptr<uint8>"), cast(line.len() - sep - 1, "int64"))
            if u == user && p == pass { return true }
        }
        return false
    }
}

public fun method_reply(method: uint8) -> bytes {
    set r: bytes = []
    r.push(5u8)
    r.push(method)
    return r
}

public fun userpass_reply(ok: bool) -> bytes {
    set r: bytes = []
    r.push(1u8)
    if ok { r.push(0u8) } else { r.push(1u8) }
    return r
}

public fun socks5_reply(rep: uint8) -> bytes {
    // VER REP RSV ATYP(1) BND.ADDR(4x0) BND.PORT(2x0)
    set r: bytes = []
    r.push(5u8)
    r.push(rep)
    r.push(0u8)
    r.push(1u8)
    r.push(0u8)
    r.push(0u8)
    r.push(0u8)
    r.push(0u8)
    r.push(0u8)
    r.push(0u8)
    return r
}

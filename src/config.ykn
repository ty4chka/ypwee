// ypwee — config: key=value lines, ACL + SSRF guard (documented API only)
load std.io: eprint
load std.fs: read_text, file_exists

public class Config {
    mode: string
    socks5_addr: string
    http_addr: string
    users: string[]
    allow_targets: string[]      // host or *.suffix or *
    allow_private_targets: bool
    rate_per_sec: int64
    hs_timeout_s: int64
    idle_timeout_s: int64
    max_conns: int64

    fun init() {
        rewrite this.mode = "all"
        rewrite this.socks5_addr = "127.0.0.1:1080"
        rewrite this.http_addr = "127.0.0.1:8081"
        rewrite this.users = []
        rewrite this.allow_targets = []
        rewrite this.allow_private_targets = false
    rewrite this.rate_per_sec = 50
    rewrite this.hs_timeout_s = 30
    rewrite this.idle_timeout_s = 300
    rewrite this.max_conns = 1024
    }

    fun apply(line: string) {
        set start = 0
        set end = line.len()
        while start < end {
            set c = line[start]
            if c == 32u8 || c == 9u8 { rewrite start += 1 } else { break }
        }
        while end > start {
            set c = line[end - 1]
            if c == 32u8 || c == 9u8 { rewrite end -= 1 } else { break }
        }
        if start >= end { return }
        if line[start] == 35u8 { return }
        set eq = -1
        for i in start..end {
            if line[i] == 61u8 { rewrite eq = i; break }
        }
        if eq < 0 { return }
        set key: string = ypwee_trim2(line, start, eq)
        set val: string = ypwee_trim2(line, eq + 1, end)
        if key == "mode" { rewrite this.mode = val }
        if key == "socks5" { rewrite this.socks5_addr = val }
        if key == "http" { rewrite this.http_addr = val }
        print("[ypwee] apply key=[" + key + "] val=[" + val + "]\n")
        if key == "user" { this.users.push(val) }
        if key == "allow" { this.allow_targets.push(val) }
        if key == "allow-private" { rewrite this.allow_private_targets = (val == "true") }
        if key == "max-conns" { rewrite this.max_conns = cast(val, "int64") }
        if key == "handshake-timeout-ms" { rewrite this.hs_timeout_s = cast(val, "int64") / 1000 }
        if key == "idle-timeout-ms" { rewrite this.idle_timeout_s = cast(val, "int64") / 1000 }
        if key == "new-conns-per-sec" { rewrite this.rate_per_sec = cast(val, "int64") }
        if key == "allow-all" { if val == "true" { this.allow_targets.push("*") } }
    }

    fun target_allowed(host: string) -> bool {
        if !this.allow_private_targets && is_private_target(host) { return false }
        for i in 0..this.allow_targets.len() {
            set a: string = this.allow_targets[i]
            if a == "*" { return true }
            if a == host { return true }
            // wildcard *.suffix
            if a[0] == 42u8 {
                set suf: string = string::from_raw_parts(cast(cast(a.as_ptr(), "int64") + 1, "ptr<uint8>"), cast(a.len() - 1, "int64"))
                if host.len() > suf.len() {
                    set tail: string = string::from_raw_parts(cast(cast(host.as_ptr(), "int64") + host.len() - suf.len(), "ptr<uint8>"), cast(suf.len(), "int64"))
                    if tail == suf { return true }
                }
            }
        }
        return false
    }
}

public fun is_private_target(host: string) -> bool {
    // v6 (contains ':')
    for i in 0..host.len() {
        if host[i] == 58u8 {
            if host == "::1" { return true }
            if host == "0:0:0:0:0:0:0:1" { return true }
            set h = host
            if h.len() >= 5 {
                set p5: string = string::from_raw_parts(h.as_ptr(), 5)
                if p5 == "fe80:" { return true }
                if p5 == "fd00:" { return true }
            }
            if h.len() >= 4 {
                set p4: string = string::from_raw_parts(h.as_ptr(), 4)
                if p4 == "fc00" || p4 == "fd00" || p4 == "fe80" { return true }
            }
            return false
        }
    }
    // domain (contains alpha)
    for i in 0..host.len() {
        set c = host[i]
        if (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) { return false }
    }
    // dotted quad
    set a: int64 = 0
    set b: int64 = 0
    set oct: int64 = 0
    set idx: int64 = 0
    set i2: int64 = 0
    while i2 < host.len() && idx < 4 {
        set v: int64 = 0
        set digits: int64 = 0
        while i2 < host.len() && host[i2] != 46u8 {
            set c2 = host[i2]
            if c2 < 48u8 || c2 > 57u8 { return true }
            rewrite v = v * 10 + cast(c2 - 48u8, "int64")
            rewrite digits += 1
            if digits > 3 { return true }
            rewrite i2 += 1
        }
        if digits == 0 { return true }
        if idx == 0 { rewrite a = v }
        if idx == 1 { rewrite b = v }
        rewrite oct += 1
        rewrite i2 += 1
        rewrite idx += 1
    }
    if oct != 4 { return true }
    if a == 127 || a == 10 || a == 0 { return true }
    if a == 192 && b == 168 { return true }
    if a == 172 && b >= 16 && b <= 31 { return true }
    if a == 169 && b == 254 { return true }
    if a >= 224 { return true }
    return false
}

public fun load_config(path: string) -> Config {
    set cfg = init Config()
    if !file_exists(path) {
        eprint("[ypwee] config missing: " + path + "; using defaults\n")
        return cfg
    }
    set text = read_text(path)
    set i: int64 = 0
    set s: int64 = 0
    while i <= text.len() {
        if i == text.len() || text[i] == 10u8 {
            if i > s {
                set line: string = ypwee_trim2(text, s, i)
                cfg.apply(line)
            }
            rewrite s = i + 1
        }
        rewrite i += 1
    }
    return cfg
}

public fun ypwee_trim2(line: string, from: int64, to: int64) -> string {
    set s = from
    set e = to
    while s < e {
        set c = line[s]
        if c == 32u8 || c == 9u8 { rewrite s += 1 } else { break }
    }
    while e > s {
        set c = line[e - 1]
        if c == 32u8 || c == 9u8 { rewrite e -= 1 } else { break }
    }
    if s >= e { return "" }
    set p2 = line.as_ptr()
    set p3 = cast(p2, "int64") + s
    return string::from_raw_parts(cast(p3, "ptr<uint8>"), e - s)
}

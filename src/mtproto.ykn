// ypwee — MTProto fake-TLS (M2/M3) — mtg v2 compatible
// Все данные — string (Copy type). bytes только через cast при hkdf.
// Работает без E0505 потому что string — Copy type.

load std.crypto: hkdf_extract, hkdf_expand
load std.crypto.hmac: hmac_sha256_init
load std.strings: byte_at
load std.strings: slice as str_slice

// hex string → bytes через std hash.common bytes_to_hex/hex_to_bytes
load std.hash.common: hex_to_bytes, bytes_to_hex

// Публичный интерфейс:
//   mtproto_parse_handshake_verify(handshake_s: string, secret_hex: string) -> int64
//   mtproto_server_proof(handshake_s: string, secret_hex: string) -> bytes
//   dc_addr(dc_id: int64) -> string

public fun mtproto_parse_handshake_verify(handshake_s: string, secret_hex: string) -> int64 {
    if handshake_s.len() < 64 { return -1 }
    // dc_id
    set dc_b0: int64 = cast(byte_at(handshake_s, 56), "int64")
    set dc_b1: int64 = cast(byte_at(handshake_s, 57), "int64")
    set dc_id: int64 = 0
    if dc_b0 >= 128 { rewrite dc_id = (dc_b0 - 128) * 256 + dc_b1 } else {
        rewrite dc_id = dc_b0 * 256 + dc_b1
    }
    if dc_id < 1 || dc_id > 5 { return -1 }
    // FakeTLS challenge: HMAC-SHA256(secret_hex → bytes, [0..56] handshake) [16..32] == bytes[48..56]
    set secret_b: bytes = hex_to_bytes(secret_hex)
    set hmac_ctx = hmac_sha256_init(ref secret_b)
    set prefix: bytes = cast("", "bytes")
    set i: int64 = 0
    while i < 56 {
        prefix.push(byte_at(handshake_s, i))
        rewrite i += 1
    }
    hmac_ctx.update(prefix)
    set mac: bytes = hmac_ctx.finish()
    // одноразовый cast → string, потом byte_at
    set mac_s: string = cast(mac, "string")
    set k: int64 = 0
    while k < 16 {
        if byte_at(handshake_s, 48 + k) != byte_at(mac_s, 16 + k) {
            return -1
        }
        rewrite k += 1
    }
    return dc_id
}

// Возвращает 32-байтный HMAC-SHA256 proof для ServerHello
public fun mtproto_server_proof(handshake_s: string, secret_hex: string) -> bytes {
    set secret_b: bytes = hex_to_bytes(secret_hex)
    set prefix: bytes = cast("", "bytes")
    set i: int64 = 0
    while i < 64 {
        prefix.push(byte_at(handshake_s, i))
        rewrite i += 1
    }
    set hmac_ctx = hmac_sha256_init(ref secret_b)
    hmac_ctx.update(prefix)
    return hmac_ctx.finish()
}

// Telegram Production DC table
public fun dc_addr(dc_id: int64) -> string {
    if dc_id == 1 { return "149.154.175.53:443" }
    if dc_id == 2 { return "149.154.167.51:443" }
    if dc_id == 3 { return "149.154.175.100:443" }
    if dc_id == 4 { return "149.154.167.91:443" }
    if dc_id == 5 { return "91.108.56.130:443" }
    if dc_id == 6 { return "[2001:b28:f23d:f001::a]:443" }
    if dc_id == 7 { return "[2001:67c:4e8:f004::9]:443" }
    if dc_id == 8 { return "[2001:b28:f23f:f005::a]:443" }
    return ""
}

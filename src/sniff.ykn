// ypwee — protocol sniffing by first bytes
// Возвращает:
//   0x01 = SOCKS5 (первый байт 0x05)
//   0x02 = HTTP CONNECT / GET (ASCII 0x43='C', 0x47='G', ... printable)  
//   0x03 = MTProto FakeTLS (TLS handshake: 0x16=22)
//   0x00 = unknown

public fun sniffer(data: bytes) -> int64 {
    set ds: string = cast(data, "string")  // 0-copy view

    if data.len() < 1 { return 0 }
    set b0: uint8 = byte_at(ds, 0)
    // TLS ClientHello (MTProto FakeTLS masquerading)
    if b0 == 22u8 { return 3 }
    // SOCKS5
    if b0 == 5u8 { return 1 }
    // HTTP: first char is ASCII method 'C', 'G', 'P', ...
    if b0 >= 65u8 && b0 <= 122u8 { return 2 }
    return 0
}

// Оставляем старую для совместимости
public fun is_socks5_hello(data: bytes) -> bool {
    if data.len() < 2 { return false }
    set dbs: string = cast(data, "string")
    return byte_at(dbs, 0) == 5u8
}
